rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return activeAccount() && request.auth.token.get('admin', false) == true
        && (!exists(/databases/$(database)/documents/adminSecurity/config)
          || request.auth.uid in get(/databases/$(database)/documents/adminSecurity/config).data.superAdminUids);
    }

    // Legacy signed custom claim remains the trusted Super Admin authority.
    // Registry/config can only be bootstrapped by an explicitly authorized trusted environment.
    function delegationReady() {
      return exists(/databases/$(database)/documents/adminSecurity/config)
        && get(/databases/$(database)/documents/adminSecurity/config).data.enabled == true
        && get(/databases/$(database)/documents/adminSecurity/config).data.superAdminUids is list
        && get(/databases/$(database)/documents/adminSecurity/config).data.superAdminUids.size() > 0;
    }
    function assistantAccess() { return get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data; }
    function hasPermission(permission) {
      return isAdmin() || (activeAccount() && delegationReady()
        && exists(/databases/$(database)/documents/adminAccess/$(request.auth.uid))
        && assistantAccess().role == 'admin_assistant' && assistantAccess().adminStatus == 'active'
        && permission in assistantAccess().permissions);
    }
    function protectedAccount(uid) {
      return (delegationReady() && uid in get(/databases/$(database)/documents/adminSecurity/config).data.superAdminUids)
        || (exists(/databases/$(database)/documents/adminAccess/$(uid))
          && get(/databases/$(database)/documents/adminAccess/$(uid)).data.role == 'super_admin');
    }
    function mayManageUser(uid) { return isAdmin() || (delegationReady() && uid != request.auth.uid && !protectedAccount(uid)); }
    function userActionPermission() {
      return hasPermission(request.resource.data.status == 'suspended' ? 'users_suspend'
        : request.resource.data.status == 'blocked' ? 'users_block' : 'users_manage');
    }
    function validPermissions(values) {
      return values is list && values.size() <= 21 && values.toSet().size() == values.size()
        && values.hasOnly(['dashboard_view', 'users_view', 'users_suspend', 'users_block', 'users_manage', 'listings_view', 'listings_manage', 'auctions_view', 'auctions_manage', 'purchase_requests_view', 'purchase_requests_manage', 'reports_view', 'reports_manage', 'services_view', 'services_manage', 'admin_log_view', 'assistants_view', 'assistants_create', 'assistants_edit_permissions', 'assistants_suspend', 'assistants_remove_role']);
    }
    function canDelegate(uid, permission, oldPermissions, newPermissions) {
      return delegationReady() && hasPermission(permission) && uid != request.auth.uid && !protectedAccount(uid)
        && (isAdmin() ? request.auth.uid in get(/databases/$(database)/documents/adminSecurity/config).data.superAdminUids
          : assistantAccess().permissions.hasAll(oldPermissions) && assistantAccess().permissions.hasAll(newPermissions));
    }
    function assistantAudit(uid, action, oldPermissions) {
      let log = getAfter(/databases/$(database)/documents/adminAuditLogs/$(request.resource.data.moderationLogId)).data;
      return validAudit('adminAccess',uid) && log.action == action
        && log.metadata.oldPermissions == oldPermissions && log.metadata.newPermissions == request.resource.data.permissions;
    }
    function validAssistantData() {
      let d=request.resource.data;
      return d.keys().hasOnly(['role','adminStatus','permissions','createdByAdminUid','adminCreatedAt','adminUpdatedAt','moderationLogId'])
        && d.role in ['admin_assistant','removed'] && d.adminStatus in ['active','suspended']
        && validPermissions(d.permissions) && d.adminUpdatedAt == request.time
        && d.createdByAdminUid is string && d.adminCreatedAt is timestamp && d.moderationLogId is string;
    }
    function assistantLogPermission(action) {
      return action == 'assistant_created' ? 'assistants_create'
        : action == 'assistant_permissions_updated' ? 'assistants_edit_permissions'
        : action in ['assistant_suspended','assistant_reactivated'] ? 'assistants_suspend'
        : action == 'assistant_role_removed' ? 'assistants_remove_role' : 'invalid';
    }
    function canWriteAudit(data) {
      return isAdmin() || (data.targetType == 'users' && mayManageUser(data.targetId)
          && hasPermission(data.action == 'تعليق الحساب' ? 'users_suspend' : data.action == 'حظر الحساب' ? 'users_block' : 'users_manage'))
        || (data.targetType == 'animals' && hasPermission('listings_manage'))
        || (data.targetType == 'auctions' && hasPermission('auctions_manage'))
        || (data.targetType == 'purchaseRequests' && hasPermission('purchase_requests_manage'))
        || (data.targetType == 'reports' && hasPermission('reports_manage'))
        || (data.targetType == 'serviceRequests' && hasPermission('services_manage'))
        || (data.targetType == 'accountDeletionRequests' && hasPermission('users_manage') && mayManageUser(data.targetId))
        || (data.targetType == 'adminAccess' && hasPermission(assistantLogPermission(data.action)));
    }
    match /adminSecurity/{id} { allow read: if signedIn(); allow write: if false; }
    match /adminAccess/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || hasPermission('assistants_view') || hasPermission('assistants_create') || hasPermission('assistants_edit_permissions'));
      allow list: if hasPermission('assistants_view');
      allow create: if validAssistantData() && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.role == 'admin_assistant' && request.resource.data.adminStatus == 'active'
        && request.resource.data.createdByAdminUid == request.auth.uid && request.resource.data.adminCreatedAt == request.time
        && canDelegate(uid,'assistants_create',[],request.resource.data.permissions) && assistantAudit(uid,'assistant_created',[]);
      allow update: if validAssistantData() && resource.data.role in ['admin_assistant','removed'] && (
        (resource.data.role == 'removed' && request.resource.data.role == 'admin_assistant'
          && request.resource.data.adminStatus == 'active' && request.resource.data.createdByAdminUid == request.auth.uid
          && request.resource.data.adminCreatedAt == request.time
          && canDelegate(uid,'assistants_create',resource.data.permissions,request.resource.data.permissions)
          && assistantAudit(uid,'assistant_created',resource.data.permissions))
        || (resource.data.role == 'admin_assistant' && request.resource.data.adminCreatedAt == resource.data.adminCreatedAt
          && request.resource.data.createdByAdminUid == resource.data.createdByAdminUid && (
          (changedKeysOnly(['permissions','adminUpdatedAt','moderationLogId'])
            && canDelegate(uid,'assistants_edit_permissions',resource.data.permissions,request.resource.data.permissions)
            && assistantAudit(uid,'assistant_permissions_updated',resource.data.permissions))
          || (changedKeysOnly(['adminStatus','adminUpdatedAt','moderationLogId'])
            && request.resource.data.adminStatus != resource.data.adminStatus
            && canDelegate(uid,'assistants_suspend',resource.data.permissions,request.resource.data.permissions)
            && assistantAudit(uid,request.resource.data.adminStatus == 'active' ? 'assistant_reactivated' : 'assistant_suspended',resource.data.permissions))
          || (changedKeysOnly(['role','adminStatus','permissions','adminUpdatedAt','moderationLogId'])
            && request.resource.data.role == 'removed' && request.resource.data.adminStatus == 'suspended' && request.resource.data.permissions.size() == 0
            && canDelegate(uid,'assistants_remove_role',resource.data.permissions,[])
            && assistantAudit(uid,'assistant_role_removed',resource.data.permissions))
        )));
      allow delete: if false;
    }

    function activeAccount() {
      return signedIn() && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active');
    }
    function validAudit(kind, id) {
      let log = getAfter(/databases/$(database)/documents/adminAuditLogs/$(request.resource.data.moderationLogId)).data;
      return log.adminUid == request.auth.uid && log.targetType == kind && log.targetId == id && log.timestamp == request.time;
    }
    function isOwner(fieldName) {
      return activeAccount() && resource.data[fieldName] == request.auth.uid;
    }

    function changedKeysOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function hasNoVerificationFields(data) {
      return !data.keys().hasAny([
        'verificationStatus',
        'verificationRequestedAt',
        'verificationRequestedBy',
        'verificationReviewedAt',
        'verificationReviewedBy',
        'verificationNotes',
        'verificationRejectionReason',
        'verifiedAt',
        'verifiedBy',
        'isVerified',
        'verification',
        'rejectedAt',
        'rejectedBy'
      ]);
    }

    function verificationFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'verificationStatus',
        'verificationRequestedAt',
        'verificationRequestedBy',
        'verificationReviewedAt',
        'verificationReviewedBy',
        'verificationNotes',
        'verificationRejectionReason',
        'verifiedAt',
        'verifiedBy',
        'isVerified',
        'verification',
        'rejectedAt',
        'rejectedBy'
      ]);
    }

    function hasNoPromotionFields(data) {
      return !data.keys().hasAny([
        'featuredAt',
        'featuredUntil',
        'bumpedAt'
      ]);
    }

    function promotionFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'featuredAt',
        'featuredUntil',
        'bumpedAt'
      ]);
    }

    function effectiveDocumentCountry(data) {
      return data.keys().hasAny(['country']) ? data.country : 'AE';
    }

    function validServicePrice(serviceType, country, amount, currency) {
      return (
        country == 'AE'
        && currency == 'AED'
        && (
          (serviceType == 'featured' && amount == 15)
          || (serviceType == 'bump' && amount == 7)
          || (serviceType == 'verification' && amount == 25)
        )
      ) || (
        country == 'EG'
        && currency == 'EGP'
        && (
          (serviceType == 'featured' && amount == 200)
          || (serviceType == 'bump' && amount == 100)
          || (serviceType == 'verification' && amount == 350)
        )
      );
    }

    function effectivePaymentStatus(data) {
      return data.keys().hasAny(['paymentStatus']) ? data.paymentStatus : 'unpaid';
    }

    function validPaymentOverrideReason(reason) {
      return reason in ['تجريبي', 'مجاني', 'تعويض', 'عرض ترويجي', 'قرار إداري', 'أخرى'];
    }

    function hasValidServiceApprovalPayment(data) {
      return (
        effectivePaymentStatus(data) == 'paid'
        && !data.keys().hasAny([
          'paymentOverride', 'paymentOverrideBy', 'paymentOverrideAt', 'paymentOverrideReason'
        ])
      ) || (
        effectivePaymentStatus(data) == 'unpaid'
        && data.paymentOverride == true
        && data.paymentOverrideBy == request.auth.uid
        && data.paymentOverrideAt == request.time
        && data.paymentOverrideReason is string
        && validPaymentOverrideReason(data.paymentOverrideReason)
      );
    }

    function conversationIsParticipant(conversationId) {
      return activeAccount()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participants;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasPermission('users_view') || hasPermission('assistants_create') || hasPermission('assistants_edit_permissions')
        || (hasPermission('assistants_view') && exists(/databases/$(database)/documents/adminAccess/$(uid))));

      allow create: if activeAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'displayName',
          'accountType',
          'status',
          'createdAt',
          'lastLoginAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'active'
        && request.resource.data.accountType in ['buyer', 'seller', 'both']
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if activeAccount()
        && request.auth.uid == uid
        && changedKeysOnly([
          'phoneNumber',
          'displayName',
          'accountType',
          'lastLoginAt',
          'updatedAt'
        ])
        && (
          !request.resource.data.keys().hasAny(['accountType'])
          || request.resource.data.accountType in ['buyer', 'seller', 'both']
        );

      allow update: if userActionPermission() && mayManageUser(uid) && uid != request.auth.uid
        && changedKeysOnly(['status', 'moderationLogId'])
        && request.resource.data.status in ['active','suspended','blocked','deletion_requested']
        && validAudit('users', uid);
      allow delete: if false;
    }

    function validListingImages(data) {
      return data.images is list && data.images.size() >= 1 && data.images.size() <= 3
        && data.images.toSet().size() == data.images.size()
        && data.images[0] is string && data.images[0].size() > 0
        && (data.images.size() < 2 || (data.images[1] is string && data.images[1].size() > 0))
        && (data.images.size() < 3 || (data.images[2] is string && data.images[2].size() > 0));
    }
    function validPetCategory(data) {
      return data.get('type', '') != 'حيوانات أليفة' || (data.saleType == 'direct'
        && data.get('subcategory', '') in ['', 'قطط', 'كلاب', 'طيور زينة', 'أرانب', 'أسماك', 'أخرى']);
    }
    // Only the registered owner can configure this public advertising surface.
    function validHeroSlot(slot) {
      return slot is map && slot.keys().hasOnly(['animalId','active','priority','startAt','endAt'])
        && slot.animalId is string && slot.animalId.size() > 0 && slot.animalId.size() <= 128
        && slot.active is bool && slot.priority is int && slot.priority >= 0 && slot.priority <= 99
        && slot.startAt is timestamp && slot.endAt is timestamp && slot.endAt > slot.startAt;
    }
    match /homePage/{id} {
      allow read: if id == 'config';
      allow create, update: if id == 'config' && isAdmin()
        && request.resource.data.keys().hasOnly(['mode','imageUrl','featured','updatedAt','updatedBy'])
        && request.resource.data.mode in ['static','featured']
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() < 2000
        && (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('https://res[.]cloudinary[.]com/[a-zA-Z0-9_-]+/image/upload/[a-zA-Z0-9_./,-]+'))
        && request.resource.data.featured is list && request.resource.data.featured.size() <= 3
        && (request.resource.data.featured.size() < 1 || validHeroSlot(request.resource.data.featured[0]))
        && (request.resource.data.featured.size() < 2 || (validHeroSlot(request.resource.data.featured[1]) && request.resource.data.featured[0].animalId != request.resource.data.featured[1].animalId))
        && (request.resource.data.featured.size() < 3 || (validHeroSlot(request.resource.data.featured[2]) && request.resource.data.featured[0].animalId != request.resource.data.featured[2].animalId && request.resource.data.featured[1].animalId != request.resource.data.featured[2].animalId))
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /animals/{animalId} {
      allow read: if true;

      allow create: if activeAccount()
        && validListingImages(request.resource.data)
        && validPetCategory(request.resource.data)
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.saleType in ['direct', 'auction']
        && request.resource.data.country in ['AE', 'EG']
        && request.resource.data.region is string
        && request.resource.data.region.size() > 0
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && (
          request.resource.data.saleType != 'direct'
          || !request.resource.data.keys().hasAny(['sellerPhone'])
        )
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasNoVerificationFields(request.resource.data)
        && hasNoPromotionFields(request.resource.data)
        && !request.resource.data.keys().hasAny(['imagesLocked','moderationLocked','moderationLogId']);

      allow update: if (
        isOwner('sellerId')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['images'])
          || validListingImages(request.resource.data)
          || (resource.data.get('images', []).size() > 3
            && request.resource.data.images is list
            && request.resource.data.images.size() > 0
            && request.resource.data.images.size() < resource.data.images.size()
            && resource.data.images.hasAll(request.resource.data.images)))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['type','subcategory']) || validPetCategory(request.resource.data))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['imagesLocked','moderationLocked','moderationLogId'])
        && (!resource.data.get('imagesLocked', false) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['images']))
        && (!resource.data.get('moderationLocked', false)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (resource.data.status == 'active'
            && request.resource.data.status in ['sold', 'not_approved']))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'sellerId',
          'saleType',
          'auctionId',
          'createdAt'
        ])
        && (
          (
            resource.data.keys().hasAny(['country'])
            && request.resource.data.country == resource.data.country
          )
          || (
            !resource.data.keys().hasAny(['country'])
            && (
              !request.resource.data.keys().hasAny(['country'])
              || request.resource.data.country == 'AE'
            )
          )
        )
        && (
          !request.resource.data.keys().hasAny(['country'])
          || (
            request.resource.data.country in ['AE', 'EG']
            && request.resource.data.region is string
            && request.resource.data.region.size() > 0
            && request.resource.data.city is string
            && request.resource.data.city.size() > 0
          )
        )
        && (
          request.resource.data.saleType != 'direct'
          || !request.resource.data.keys().hasAny(['sellerPhone'])
        )
        && verificationFieldsUnchanged()
        && promotionFieldsUnchanged()
      ) || (
        hasPermission('services_manage')
        && (
          (
            changedKeysOnly(['featuredAt', 'featuredUntil'])
            && request.resource.data.featuredAt == request.time
            && request.resource.data.featuredUntil is timestamp
            && request.resource.data.featuredUntil > request.time
            && request.resource.data.featuredUntil <= request.time + duration.value(8, 'd')
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_animal_' + animalId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_animal_' + animalId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_animal_' + animalId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_animal_' + animalId)).data.approvedAt == request.time
          )
          || (
            changedKeysOnly(['bumpedAt'])
            && request.resource.data.bumpedAt == request.time
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_animal_' + animalId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_animal_' + animalId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_animal_' + animalId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_animal_' + animalId)).data.approvedAt == request.time
          )
          || (
            changedKeysOnly(['verificationStatus', 'verifiedAt', 'verifiedBy'])
            && request.resource.data.verificationStatus == 'verified'
            && request.resource.data.verifiedAt == request.time
            && request.resource.data.verifiedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_verification_animal_' + animalId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_verification_animal_' + animalId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_verification_animal_' + animalId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_verification_animal_' + animalId)).data.approvedAt == request.time
          )
        )
      );

      allow update: if hasPermission('listings_manage')
        && changedKeysOnly(['images','imagesLocked','moderationLocked','status','moderationLogId'])
        && request.resource.data.moderationLocked == true
        && request.resource.data.status in ['active','hidden','needs_review','sold','not_approved']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['images']) || (
          request.resource.data.images is list
          && request.resource.data.images.size() < resource.data.images.size()
          && request.resource.data.images.toSet().difference(resource.data.images.toSet()).size() == 0
          && request.resource.data.imagesLocked == true
          && (request.resource.data.images.size() > 0 || request.resource.data.status == 'needs_review')))
        && validAudit('animals', animalId);
      allow delete: if isOwner('sellerId') && !resource.data.get('moderationLocked', false);
    }

    match /auctions/{auctionId} {
      allow read: if true;

      allow create: if activeAccount()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.country in ['AE', 'EG']
        && getAfter(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.country == request.resource.data.country
        && getAfter(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.sellerId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.saleType == 'auction'
        && request.resource.data.status == 'active'
        && !request.resource.data.keys().hasAny(['lastBidderId', 'lastBidderPhone', 'lastBidAt', 'winnerId', 'winnerPhone'])
        && request.resource.data.startPrice > 0
        && request.resource.data.startPrice is number
        && request.resource.data.currentPrice == request.resource.data.startPrice
        && request.resource.data.minIncrement is number
        && request.resource.data.minIncrement > 0
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasNoVerificationFields(request.resource.data)
        && hasNoPromotionFields(request.resource.data);

      allow update: if (
        activeAccount()
        && (
          (
            resource.data.keys().hasAny(['country'])
            && request.resource.data.country == resource.data.country
          )
          || (
            !resource.data.keys().hasAny(['country'])
            && (
              !request.resource.data.keys().hasAny(['country'])
              || request.resource.data.country == 'AE'
            )
          )
        )
        && (
        (
          resource.data.sellerId != request.auth.uid
          && resource.data.status == 'active'
          && (!exists(/databases/$(database)/documents/animals/$(resource.data.animalId))
            || get(/databases/$(database)/documents/animals/$(resource.data.animalId)).data.get('status', 'active') == 'active')
          && resource.data.endTime is timestamp
          && request.time < resource.data.endTime
          && changedKeysOnly([
            'currentPrice',
            'lastBidAt',
            'lastBidderId',
            'lastBidderPhone'
          ])
          && request.resource.data.currentPrice is number
          && request.resource.data.currentPrice >=
            resource.data.currentPrice + resource.data.minIncrement
          && request.resource.data.lastBidderId == request.auth.uid
          && request.resource.data.lastBidAt == request.time
        )
        ||
        (
          resource.data.sellerId == request.auth.uid
          && resource.data.status == 'active'
          && resource.data.endTime is timestamp
          && request.time >= resource.data.endTime
          && changedKeysOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['sold', 'not_approved']
          && request.resource.data.updatedAt == request.time
        )
        )
      ) || (
        hasPermission('services_manage')
        && (
          (
            changedKeysOnly(['featuredAt', 'featuredUntil'])
            && request.resource.data.featuredAt == request.time
            && request.resource.data.featuredUntil is timestamp
            && request.resource.data.featuredUntil > request.time
            && request.resource.data.featuredUntil <= request.time + duration.value(8, 'd')
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_auction_' + auctionId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_auction_' + auctionId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_auction_' + auctionId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_auction_' + auctionId)).data.approvedAt == request.time
          )
          || (
            changedKeysOnly(['bumpedAt'])
            && request.resource.data.bumpedAt == request.time
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_auction_' + auctionId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_auction_' + auctionId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_auction_' + auctionId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_auction_' + auctionId)).data.approvedAt == request.time
          )
        )
      );

      allow update: if hasPermission('auctions_manage') && resource.data.status == 'active'
        && resource.data.endTime <= request.time && request.resource.data.status in ['sold','not_approved']
        && changedKeysOnly(['status','updatedAt','moderationLogId']) && request.resource.data.updatedAt == request.time
        && validAudit('auctions',auctionId);
      allow delete: if isOwner('sellerId');
    }

    // Private, existing participation aggregate. A record can only advance with
    // the same successful auction price update; it cannot fabricate past bids.
    match /auctionParticipations/{participationId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/auctionParticipations/$(participationId))
        || resource.data.bidderId == request.auth.uid
      );
      allow list: if signedIn() && resource.data.bidderId == request.auth.uid;

      function validParticipation() {
        let data = request.resource.data;
        let auction = get(/databases/$(database)/documents/auctions/$(data.auctionId)).data;
        let after = getAfter(/databases/$(database)/documents/auctions/$(data.auctionId)).data;
        return data.keys().hasOnly(['auctionId','animalId','sellerId','bidderId','lastBidAmount','lastBidAt','createdAt'])
          && data.bidderId == request.auth.uid
          && participationId == data.auctionId + '_' + request.auth.uid
          && data.animalId == auction.animalId
          && data.sellerId == auction.sellerId
          && auction.sellerId != request.auth.uid
          && auction.status == 'active' && request.time < auction.endTime
          && data.lastBidAmount is number
          && data.lastBidAmount > auction.currentPrice
          && data.lastBidAmount == after.currentPrice
          && after.lastBidderId == request.auth.uid
          && data.lastBidAt == request.time && after.lastBidAt == request.time;
      }
      allow create: if activeAccount() && validParticipation()
        && request.resource.data.createdAt == request.time;
      allow update: if activeAccount() && resource.data.bidderId == request.auth.uid
        && validParticipation()
        && changedKeysOnly(['lastBidAmount','lastBidAt'])
        && request.resource.data.lastBidAmount > resource.data.lastBidAmount;
      allow delete: if false;
    }

    match /serviceRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || hasPermission('services_view'));

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'userId',
          'serviceType',
          'targetType',
          'targetId',
          'country',
          'amount',
          'currency',
          'paymentStatus',
          'status',
          'createdAt',
          'updatedAt',
          'notes',
          'details'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.serviceType in ['featured', 'bump', 'verification']
        && request.resource.data.targetType in ['animal', 'auction']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && requestId == request.auth.uid + '_' + request.resource.data.serviceType
          + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.country in ['AE', 'EG']
        && request.resource.data.amount is number
        && validServicePrice(
          request.resource.data.serviceType,
          request.resource.data.country,
          request.resource.data.amount,
          request.resource.data.currency
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'unpaid'
        && !request.resource.data.keys().hasAny([
          'paymentOverride', 'paymentOverrideBy', 'paymentOverrideAt', 'paymentOverrideReason'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.serviceType != 'verification'
            && !request.resource.data.keys().hasAny(['notes', 'details'])
          )
          || (
            request.resource.data.serviceType == 'verification'
            && request.resource.data.targetType == 'animal'
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 1000
            && request.resource.data.details is map
            && request.resource.data.details.keys().hasOnly([
              'animalIdentifier',
              'vaccinationStatus',
              'vaccinationDate',
              'vetInspectionStatus',
              'vetInspectionDate'
            ])
            && request.resource.data.details.animalIdentifier is string
            && request.resource.data.details.vaccinationStatus is string
            && request.resource.data.details.vaccinationDate is string
            && request.resource.data.details.vetInspectionStatus is string
            && request.resource.data.details.vetInspectionDate is string
          )
        )
        && (
          (
            request.resource.data.targetType == 'animal'
            && exists(/databases/$(database)/documents/animals/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/animals/$(request.resource.data.targetId)).data.sellerId == request.auth.uid
            && (
              request.resource.data.serviceType == 'verification'
              || get(/databases/$(database)/documents/animals/$(request.resource.data.targetId)).data.saleType == 'direct'
            )
            && effectiveDocumentCountry(
              get(/databases/$(database)/documents/animals/$(request.resource.data.targetId)).data
            ) == request.resource.data.country
          )
          || (
            request.resource.data.targetType == 'auction'
            && request.resource.data.serviceType in ['featured', 'bump']
            && exists(/databases/$(database)/documents/auctions/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/auctions/$(request.resource.data.targetId)).data.sellerId == request.auth.uid
            && effectiveDocumentCountry(
              get(/databases/$(database)/documents/auctions/$(request.resource.data.targetId)).data
            ) == request.resource.data.country
          )
        );

      allow update: if (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && changedKeysOnly(['status', 'cancelledAt', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
      ) || (
        hasPermission('services_manage')
        && resource.data.status == 'pending'
        && request.resource.data.updatedAt == request.time
        && (
          (
            changedKeysOnly(['status', 'approvedAt', 'approvedBy', 'updatedAt'])
            && request.resource.data.status == 'approved'
            && effectivePaymentStatus(resource.data) == 'paid'
            && !request.resource.data.keys().hasAny([
              'paymentOverride', 'paymentOverrideBy', 'paymentOverrideAt', 'paymentOverrideReason'
            ])
            && request.resource.data.approvedAt == request.time
            && request.resource.data.approvedBy == request.auth.uid
            && (
              (
                resource.data.targetType == 'animal'
                && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.sellerId == resource.data.userId
                && effectiveDocumentCountry(getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data) == resource.data.country
                && (
                  (
                    resource.data.serviceType == 'featured'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.featuredAt == request.time
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.featuredUntil > request.time
                  )
                  || (
                    resource.data.serviceType == 'bump'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.bumpedAt == request.time
                  )
                  || (
                    resource.data.serviceType == 'verification'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verificationStatus == 'verified'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verifiedAt == request.time
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verifiedBy == request.auth.uid
                  )
                )
              )
              || (
                resource.data.targetType == 'auction'
                && resource.data.serviceType in ['featured', 'bump']
                && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.sellerId == resource.data.userId
                && effectiveDocumentCountry(getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data) == resource.data.country
                && (
                  (
                    resource.data.serviceType == 'featured'
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.featuredAt == request.time
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.featuredUntil > request.time
                  )
                  || (
                    resource.data.serviceType == 'bump'
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.bumpedAt == request.time
                  )
                )
              )
            )
          )
          || (
            changedKeysOnly([
              'status', 'approvedAt', 'approvedBy', 'updatedAt',
              'paymentOverride', 'paymentOverrideBy', 'paymentOverrideAt', 'paymentOverrideReason'
            ])
            && request.resource.data.status == 'approved'
            && effectivePaymentStatus(resource.data) == 'unpaid'
            && request.resource.data.paymentOverride == true
            && request.resource.data.paymentOverrideBy == request.auth.uid
            && request.resource.data.paymentOverrideAt == request.time
            && request.resource.data.paymentOverrideReason is string
            && validPaymentOverrideReason(request.resource.data.paymentOverrideReason)
            && request.resource.data.approvedAt == request.time
            && request.resource.data.approvedBy == request.auth.uid
            && (
              (
                resource.data.targetType == 'animal'
                && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.sellerId == resource.data.userId
                && effectiveDocumentCountry(getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data) == resource.data.country
                && (
                  (
                    resource.data.serviceType == 'featured'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.featuredAt == request.time
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.featuredUntil > request.time
                  )
                  || (
                    resource.data.serviceType == 'bump'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.bumpedAt == request.time
                  )
                  || (
                    resource.data.serviceType == 'verification'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verificationStatus == 'verified'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verifiedAt == request.time
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verifiedBy == request.auth.uid
                  )
                )
              )
              || (
                resource.data.targetType == 'auction'
                && resource.data.serviceType in ['featured', 'bump']
                && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.sellerId == resource.data.userId
                && effectiveDocumentCountry(getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data) == resource.data.country
                && (
                  (
                    resource.data.serviceType == 'featured'
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.featuredAt == request.time
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.featuredUntil > request.time
                  )
                  || (
                    resource.data.serviceType == 'bump'
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.bumpedAt == request.time
                  )
                )
              )
            )
          )
          || (
            changedKeysOnly(['status', 'rejectedAt', 'rejectedBy', 'updatedAt', 'adminNote'])
            && request.resource.data.status == 'rejected'
            && request.resource.data.rejectedAt == request.time
            && request.resource.data.rejectedBy == request.auth.uid
            && (
              !request.resource.data.keys().hasAny(['adminNote'])
              || (
                request.resource.data.adminNote is string
                && request.resource.data.adminNote.size() <= 1000
              )
            )
          )
        )
      );

      allow delete: if false;
    }

    match /purchaseRequests/{requestId} {
      allow read: if signedIn()
        && (
          hasPermission('purchase_requests_view') || resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        );

      allow create: if activeAccount()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        )
        && get(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.sellerId == request.resource.data.sellerId
        && get(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.price == request.resource.data.price
        && get(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.saleType == 'direct'
        && get(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.status == 'active';

      allow update: if activeAccount()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'pending'
        && changedKeysOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.updatedAt == request.time;

      allow update: if hasPermission('purchase_requests_manage') && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted','rejected'] && changedKeysOnly(['status','updatedAt','moderationLogId'])
        && request.resource.data.updatedAt == request.time && validAudit('purchaseRequests',requestId);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (
          (
            !exists(
              /databases/$(database)/documents/conversations/$(conversationId)
            )
            && conversationId.matches(
              '^direct_.+_' + request.auth.uid + '$'
            )
          )
          || request.auth.uid in resource.data.participants
        );

      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if activeAccount()
        && request.resource.data.contextType == 'direct'
        && !request.resource.data.keys().hasAny(['contactStatus', 'acceptedOfferId', 'contactUnlockedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.sellerId != request.resource.data.buyerId
        && request.resource.data.participants.hasAll([
          request.resource.data.sellerId,
          request.resource.data.buyerId
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastMessageType == ''
        && request.resource.data.lastMessageSenderId == ''
        && request.resource.data.sellerUnread == 0
        && request.resource.data.buyerUnread == 0
        && (
          (
            request.resource.data.contextType == 'direct'
            && request.auth.uid == request.resource.data.buyerId
            && exists(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            )
            && get(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            ).data.saleType == 'direct'
            && get(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            ).data.status == 'active'
            && get(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            ).data.sellerId == request.resource.data.sellerId
            && get(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            ).data.price == request.resource.data.askingPrice
          )
          ||
          (
            request.resource.data.contextType == 'auction'
            && exists(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            )
            && get(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            ).data.status == 'sold'
            && get(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            ).data.sellerId == request.resource.data.sellerId
            && get(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            ).data.lastBidderId == request.resource.data.buyerId
            && get(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            ).data.animalId == request.resource.data.animalId
            && (
              (
                get(
                  /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
                ).data.keys().hasAny(['currentPrice'])
                && get(
                  /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
                ).data.currentPrice == request.resource.data.finalPrice
              )
              ||
              (
                !get(
                  /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
                ).data.keys().hasAny(['currentPrice'])
                && get(
                  /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
                ).data.startPrice == request.resource.data.finalPrice
              )
            )
            && request.auth.uid in request.resource.data.participants
          )
        );

      allow update: if activeAccount()
        && request.auth.uid in resource.data.participants
        && (
          (
            resource.data.sellerId == request.auth.uid
            && changedKeysOnly(['sellerUnread'])
            && request.resource.data.sellerUnread == 0
          )
          ||
          (
            resource.data.buyerId == request.auth.uid
            && changedKeysOnly(['buyerUnread'])
            && request.resource.data.buyerUnread == 0
          )
          ||
          (
            request.resource.data.lastMessage is string
            && request.resource.data.lastMessageType in ['text', 'offer']
            && request.resource.data.lastMessageSenderId == request.auth.uid
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.updatedAt == request.time
            && (
              request.resource.data.lastMessageType != 'offer'
              || (
                resource.data.contextType == 'direct'
                && request.resource.data.lastOfferAmount is number
                && request.resource.data.lastOfferAmount > 0
              )
            )
            && (
              (
                resource.data.sellerId == request.auth.uid
                && changedKeysOnly([
                  'lastMessage',
                  'lastMessageType',
                  'lastOfferAmount',
                  'lastMessageSenderId',
                  'lastMessageAt',
                  'buyerUnread',
                  'updatedAt'
                ])
                && request.resource.data.buyerUnread ==
                  (resource.data.keys().hasAny(['buyerUnread'])
                    ? resource.data.buyerUnread
                    : 0) + 1
              )
              ||
              (
                resource.data.buyerId == request.auth.uid
                && changedKeysOnly([
                  'lastMessage',
                  'lastMessageType',
                  'lastOfferAmount',
                  'lastMessageSenderId',
                  'lastMessageAt',
                  'sellerUnread',
                  'updatedAt'
                ])
                && request.resource.data.sellerUnread ==
                  (resource.data.keys().hasAny(['sellerUnread'])
                    ? resource.data.sellerUnread
                    : 0) + 1
              )
            )
          )
          ||
          (
            resource.data.contextType == 'direct'
            && resource.data.sellerId == request.auth.uid
            && !resource.data.keys().hasAny(['contactStatus'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage',
              'lastMessageType',
              'lastMessageSenderId',
              'lastMessageAt',
              'buyerUnread',
              'updatedAt',
              'contactStatus',
              'acceptedOfferId',
              'contactUnlockedAt'
            ])
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessageType == 'text'
            && request.resource.data.lastMessageSenderId == request.auth.uid
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.buyerUnread ==
              (resource.data.keys().hasAny(['buyerUnread'])
                ? resource.data.buyerUnread
                : 0) + 1
            && request.resource.data.contactStatus == 'unlocked'
            && request.resource.data.acceptedOfferId is string
            && request.resource.data.contactUnlockedAt == request.time
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.type == 'offer'
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.senderId == resource.data.buyerId
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.status == 'accepted'
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.decidedBy == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.decidedAt == request.time
          )
          ||
          (
            resource.data.contextType == 'direct'
            && resource.data.sellerId == request.auth.uid
            && (
              !resource.data.keys().hasAny(['contactStatus'])
              || resource.data.contactStatus != 'unlocked'
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'contactStatus',
              'acceptedOfferId',
              'contactUnlockedAt'
            ])
            && request.resource.data.contactStatus == 'unlocked'
            && request.resource.data.acceptedOfferId is string
            && request.resource.data.contactUnlockedAt == request.time
            && get(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.type == 'offer'
            && get(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.senderId == resource.data.buyerId
            && get(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.status == 'accepted'
            && get(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.decidedBy == resource.data.sellerId
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if conversationIsParticipant(conversationId);

        allow create: if conversationIsParticipant(conversationId)
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.contextType == 'direct'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.keys().hasOnly([
                'type', 'text', 'senderId', 'createdAt'
              ])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1000
            )
            ||
            (
              request.resource.data.type == 'offer'
              && request.resource.data.keys().hasOnly([
                'type', 'offerAmount', 'text', 'status', 'senderId', 'createdAt'
              ])
              && request.resource.data.status == 'pending'
              && get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contextType == 'direct'
              && get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.buyerId == request.auth.uid
              && request.resource.data.offerAmount is number
              && request.resource.data.offerAmount > 0
              && (
                !request.resource.data.keys().hasAny(['text'])
                || (
                  request.resource.data.text is string
                  && request.resource.data.text.size() <= 1000
                )
              )
            )
          );

        allow update: if conversationIsParticipant(conversationId)
          && get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.contextType == 'direct'
          && get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.sellerId == request.auth.uid
          && resource.data.type == 'offer'
          && resource.data.senderId == get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.buyerId
          && (
            !resource.data.keys().hasAny(['status'])
            || resource.data.status == 'pending'
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'decidedBy', 'decidedAt'
          ])
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.decidedBy == request.auth.uid
          && request.resource.data.decidedAt == request.time
          && (
            request.resource.data.status != 'accepted'
            || (
              getAfter(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contactStatus == 'unlocked'
              && getAfter(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.acceptedOfferId == messageId
              && getAfter(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contactUnlockedAt == request.time
            )
          );

        allow delete: if false;
      }

      match /privateContacts/{contactUid} {
        allow get: if signedIn()
          && (
            contactUid == request.auth.uid
            || (
              conversationIsParticipant(conversationId)
              && contactUid in get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.participants
              && get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contextType == 'direct'
              && get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contactStatus == 'unlocked'
            )
          );

        allow list: if false;

        allow create: if activeAccount()
          && contactUid == request.auth.uid
          && conversationIsParticipant(conversationId)
          && get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.contextType == 'direct'
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'phoneNumber', 'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName == get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.displayName
          && (
            !request.resource.data.keys().hasAny(['phoneNumber'])
            || (
              request.resource.data.phoneNumber is string
              && request.resource.data.phoneNumber == get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.phoneNumber
            )
          )
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /accountDeletionRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || hasPermission('users_view'));
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('users_view'));
      allow create: if activeAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasPermission('users_manage') && mayManageUser(uid)
        && resource.data.status in ['pending', 'in_review']
        && request.resource.data.status in ['in_review', 'completed']
        && changedKeysOnly(['status', 'updatedAt', 'processedBy', 'processedAt'])
        && request.resource.data.processedBy == request.auth.uid
        && request.resource.data.processedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if hasPermission('reports_view') || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly(['reporterId','targetType','targetId','reportedUserId','reason','details','status','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['user','animal','auction']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 128
        && reportId == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
        && request.resource.data.details is string && request.resource.data.details.size() <= 2000
        && ((request.resource.data.targetType == 'user'
          && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId))
          && request.resource.data.reportedUserId == request.resource.data.targetId)
          || (request.resource.data.targetType == 'animal'
          && get(/databases/$(database)/documents/animals/$(request.resource.data.targetId)).data.sellerId == request.resource.data.reportedUserId)
          || (request.resource.data.targetType == 'auction'
          && get(/databases/$(database)/documents/auctions/$(request.resource.data.targetId)).data.sellerId == request.resource.data.reportedUserId));
      allow update: if hasPermission('reports_manage') && changedKeysOnly(['status','reviewedAt','reviewedBy','resolutionNotes','moderationLogId'])
        && request.resource.data.status in ['reviewing','resolved','rejected']
        && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.resolutionNotes is string && request.resource.data.resolutionNotes.size() <= 500
        && validAudit('reports', reportId);
      allow delete: if false;
    }
    match /adminAuditLogs/{logId} {
      allow read: if hasPermission('admin_log_view');
      allow create: if canWriteAudit(request.resource.data)
        && request.resource.data.keys().hasOnly(['adminUid','action','targetType','targetId','reason','timestamp','metadata'])
        && request.resource.data.adminUid == request.auth.uid && request.resource.data.timestamp == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 100
        && request.resource.data.targetType in ['users','animals','auctions','purchaseRequests','reports','serviceRequests','accountDeletionRequests','adminAccess']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 300
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
        && request.resource.data.metadata is map && (
          (request.resource.data.targetType != 'adminAccess' && request.resource.data.metadata.keys().hasOnly(['imageHash'])
            && (!request.resource.data.metadata.keys().hasAny(['imageHash']) || request.resource.data.metadata.imageHash.matches('^[a-f0-9]{64}$')))
          || (request.resource.data.targetType == 'adminAccess'
            && request.resource.data.metadata.keys().hasOnly(['oldPermissions','newPermissions'])
            && validPermissions(request.resource.data.metadata.oldPermissions) && validPermissions(request.resource.data.metadata.newPermissions)
            && getAfter(/databases/$(database)/documents/adminAccess/$(request.resource.data.targetId)).data.moderationLogId == logId
            && getAfter(/databases/$(database)/documents/adminAccess/$(request.resource.data.targetId)).data.adminUpdatedAt == request.time)
        );
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
