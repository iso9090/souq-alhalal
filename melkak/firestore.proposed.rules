// LOCAL PROPOSAL ONLY. Never deploy this standalone file over Production Rules.
// This emulator policy denies legacy writes. Published legacy policy remains unchanged.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function active(){return request.auth!=null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status=='active';}
  function registry(){return get(/databases/$(database)/documents/adminSecurity/config).data;}
  function owner(){return active() && request.auth.token.get('admin',false)==true && registry().enabled==true && request.auth.uid in registry().superAdminUids;}
  function permit(p){return owner() || (active() && registry().enabled==true && registry().superAdminUids.size()>0 && get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.role=='admin_assistant' && get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.adminStatus=='active' && p in get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.permissions);}
  function countryEnabled(country){return country in ['AE','SA','EG','OM','JO','MA'] && (!exists(/databases/$(database)/documents/marketplaceSettings/public) || country in get(/databases/$(database)/documents/marketplaceSettings/public).data.enabledCountries);}
  function categoryEnabled(category){return exists(/databases/$(database)/documents/marketplaceCategories/$(category)) && get(/databases/$(database)/documents/marketplaceCategories/$(category)).data.enabled==true;}
  function currency(c){return c=='AE'?'AED':c=='SA'?'SAR':c=='EG'?'EGP':c=='OM'?'OMR':c=='JO'?'JOD':c=='MA'?'MAD':'';}
  function image(v){return v is string && v.size()<=210000 && v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$');}
  function images(d){return d.images is list && d.images.size()>=1 && d.images.size()<=3 && d.images.toSet().size()==d.images.size() && image(d.images[0]) && (d.images.size()<2 || image(d.images[1])) && (d.images.size()<3 || image(d.images[2]));}
  function contact(d){let c=d.contact;return c is map && c.keys().hasOnly(['phone','consent','call','whatsapp','showNumber']) && c.consent==true && c.call is bool && c.whatsapp is bool && c.showNumber is bool && (c.call||c.whatsapp) && c.phone is string && c.phone.matches('^\\+[1-9][0-9]{7,14}$');}
  function attr(d,k){return d.attributes.get(k,'') is string && d.attributes.get(k,'').size()<=300;}
  function fields(d){return d.attributes is map && (d.category=='livestock'?(d.attributes.keys().hasOnly(['type','breed','age','gender','color','health','identifier']) && attr(d,'type') && attr(d,'breed') && attr(d,'age') && attr(d,'gender') && attr(d,'color') && attr(d,'health') && attr(d,'identifier')):d.category=='cars'?(d.attributes.keys().hasOnly(['brand','model','year','mileage','fuel','transmission','condition','color']) && attr(d,'brand') && attr(d,'model') && attr(d,'year') && attr(d,'mileage') && attr(d,'fuel') && attr(d,'transmission') && attr(d,'condition') && attr(d,'color')):d.category=='phones'?(d.attributes.keys().hasOnly(['brand','model','capacity','condition','color']) && attr(d,'brand') && attr(d,'model') && attr(d,'capacity') && attr(d,'condition') && attr(d,'color')):d.category=='computers'?(d.attributes.keys().hasOnly(['type','brand','model','specs','condition']) && attr(d,'type') && attr(d,'brand') && attr(d,'model') && attr(d,'specs') && attr(d,'condition')):d.category=='appliances'?(d.attributes.keys().hasOnly(['type','brand','condition','age']) && attr(d,'type') && attr(d,'brand') && attr(d,'condition') && attr(d,'age')):d.category=='furniture'?(d.attributes.keys().hasOnly(['type','condition','material','color']) && attr(d,'type') && attr(d,'condition') && attr(d,'material') && attr(d,'color')):d.category=='children'?(d.attributes.keys().hasOnly(['type','suitableAge','condition']) && attr(d,'type') && attr(d,'suitableAge') && attr(d,'condition')):d.category=='tools'?(d.attributes.keys().hasOnly(['type','brand','condition']) && attr(d,'type') && attr(d,'brand') && attr(d,'condition')):(d.attributes.keys().hasOnly(['type','condition']) && attr(d,'type') && attr(d,'condition')));}
  function valid(d){return d.keys().hasOnly(['schemaVersion','ownerUid','category','country','region','city','currency','title','description','price','images','attributes','contact','status','createdAt','updatedAt','hiddenBy','moderationLocked','moderationStatus','requiresReview','hasHistory','historyRequestId','auditId','featured','featuredStatus','featuredDurationDays','featuredStartAt','featuredEndAt','featuredRequestId','bumpedAt','bumpRequestId','featuredPriority']) && d.schemaVersion==1 && d.ownerUid is string && d.category in ['livestock','cars','phones','computers','appliances','furniture','tools','sports','children','other'] && d.country in ['AE','SA','EG','OM','JO','MA'] && d.currency==currency(d.country) && d.region is string && d.region.size()>0 && d.region.size()<=100 && d.city is string && d.city.size()>0 && d.city.size()<=100 && d.title is string && d.title.size()>=3 && d.title.size()<=100 && d.description is string && d.description.size()>=10 && d.description.size()<=2000 && d.price is number && d.price>=0 && d.price<=10000000000 && images(d) && contact(d) && fields(d);}
  function editable(d){return d.get('moderationLocked',false)==false && d.get('requiresReview',false)==false && !(d.get('moderationStatus','') in ['rejected','suspended','needs_review','pending']) && d.get('hiddenBy','')!='admin';}
  function ownerTransition(before,after){return (before.status=='active' && ((after.status in ['active','sold'] && (after.status!='active' || after.country==before.country || countryEnabled(after.country)) && after.get('hiddenBy','')==before.get('hiddenBy','')) || (after.status=='hidden' && after.hiddenBy=='owner'))) || (before.status=='hidden' && before.get('hiddenBy','')=='owner' && ((after.status=='hidden' && after.hiddenBy=='owner') || (after.status=='active' && after.hiddenBy=='' && countryEnabled(after.country) && categoryEnabled(before.category))));}
  function audit(d,collection,id,action,result){let a=getAfter(/databases/$(database)/documents/marketplaceAuditLogs/$(d.auditId)).data;return (resource==null || d.auditId!=resource.data.get('auditId','')) && a.actorUid==request.auth.uid && a.targetCollection==collection && a.targetId==id && a.action==action && a.result==result && a.timestamp==request.time;}
  function linkedHistory(d,id){let r=getAfter(/databases/$(database)/documents/marketplaceRequests/$(d.historyRequestId)).data;return d.diff(resource.data).affectedKeys().hasOnly(['hasHistory','historyRequestId','updatedAt']) && active() && resource.data.status=='active' && d.hasHistory==true && d.historyRequestId!=resource.data.get('historyRequestId','') && r.ownerUid==request.auth.uid && r.listingId==id && r.type in ['featured','bump','report'] && r.createdAt==request.time && d.diff(resource.data).affectedKeys().hasOnly(['hasHistory','historyRequestId','updatedAt']);}
  function featuredApproval(d,id){let r=getAfter(/databases/$(database)/documents/marketplaceRequests/$(d.featuredRequestId)).data;return r.type=='featured' && r.listingId==id && r.status=='approved' && r.updatedAt==request.time && owner() && resource.data.status=='active' && editable(resource.data) && d.diff(resource.data).affectedKeys().hasOnly(['featured','featuredStatus','featuredDurationDays','featuredStartAt','featuredEndAt','featuredRequestId','hasHistory','auditId','updatedAt']) && d.hasHistory==true && d.featured==true && d.featuredStatus=='approved' && d.featuredDurationDays is int && d.featuredDurationDays>=1 && d.featuredDurationDays<=365 && d.featuredStartAt is number && d.featuredEndAt-d.featuredStartAt==d.featuredDurationDays*86400000 && audit(d,'marketplaceListings',id,'featured-approved','approved');}
  function bumpApproval(d,id){let r=getAfter(/databases/$(database)/documents/marketplaceRequests/$(d.bumpRequestId)).data;return owner() && resource.data.status=='active' && editable(resource.data) && r.type=='bump' && r.listingId==id && r.status=='approved' && r.updatedAt==request.time && d.bumpedAt==request.time && d.hasHistory==true && d.diff(resource.data).affectedKeys().hasOnly(['bumpedAt','bumpRequestId','hasHistory','auditId','updatedAt']) && audit(d,'marketplaceListings',id,'bump-approved','approved');}
  function priorityUpdate(d,id){return owner() && resource.data.status=='active' && resource.data.featured==true && resource.data.featuredStatus=='approved' && resource.data.featuredEndAt>request.time.toMillis() && d.featuredPriority is int && d.featuredPriority>=0 && d.featuredPriority<=100 && d.diff(resource.data).affectedKeys().hasOnly(['featuredPriority','auditId','updatedAt']) && audit(d,'marketplaceListings',id,'featured-priority','updated');}
  function deletionProof(id){let d=getAfter(/databases/$(database)/documents/marketplaceDeletions/$(id)).data;let a=getAfter(/databases/$(database)/documents/marketplaceAuditLogs/$(d.auditId)).data;return owner() && resource.data.get('hasHistory',true)==false && d.listingId==id && d.ownerUid==resource.data.ownerUid && d.actorUid==request.auth.uid && d.timestamp==request.time && a.action=='listing-deleted' && a.targetCollection=='marketplaceListings' && a.targetId==id && a.result=='deleted' && a.actorUid==request.auth.uid && a.reason==d.reason && a.timestamp==request.time;}
  function moderation(d,id){return permit('listings_manage') && (d.status!='active' || countryEnabled(d.country)) && d.status in ['active','hidden','rejected','archived'] && d.hasHistory==true && d.moderationLocked==(d.status!='active') && d.hiddenBy==(d.status=='hidden'?'admin':'') && d.diff(resource.data).affectedKeys().hasOnly(['status','hiddenBy','moderationLocked','hasHistory','auditId','updatedAt']) && audit(d,'marketplaceListings',id,'moderate-'+d.status,d.status);}
  match /marketplaceListings/{id} {
   allow read: if resource.data.status=='active' || (active() && resource.data.ownerUid==request.auth.uid) || permit('listings_view') || permit('listings_manage');
   allow create: if active() && countryEnabled(request.resource.data.country) && categoryEnabled(request.resource.data.category) && request.resource.data.ownerUid==request.auth.uid && valid(request.resource.data) && !request.resource.data.keys().hasAny(['moderationLocked','moderationStatus','requiresReview','historyRequestId','auditId','featured','featuredStatus','featuredStartAt','featuredEndAt','featuredDurationDays','featuredRequestId','bumpedAt','bumpRequestId','featuredPriority']) && request.resource.data.hasHistory==false && request.resource.data.get('hiddenBy','')=='' && request.resource.data.status=='active' && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   allow update: if active() && request.resource.data.ownerUid==resource.data.ownerUid && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.category==resource.data.category && request.resource.data.updatedAt==request.time && ((resource.data.ownerUid==request.auth.uid && editable(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','price','images','attributes','contact','country','region','city','currency','status','hiddenBy','updatedAt']) && valid(request.resource.data) && ownerTransition(resource.data,request.resource.data)) || linkedHistory(request.resource.data,id) || priorityUpdate(request.resource.data,id) || bumpApproval(request.resource.data,id) || featuredApproval(request.resource.data,id) || moderation(request.resource.data,id));
   allow delete: if active() && ((resource.data.ownerUid==request.auth.uid && resource.data.get('hasHistory',true)==false && editable(resource.data) && resource.data.status in ['active','hidden']) || deletionProof(id));
  }
  match /marketplaceDeletions/{id}{allow read: if owner();allow create: if owner() && request.resource.data.keys().hasOnly(['listingId','ownerUid','actorUid','reason','auditId','timestamp']) && request.resource.data.listingId==id && request.resource.data.actorUid==request.auth.uid && request.resource.data.timestamp==request.time && boundedReason(request.resource.data) && exists(/databases/$(database)/documents/marketplaceListings/$(id)) && !existsAfter(/databases/$(database)/documents/marketplaceListings/$(id)) && get(/databases/$(database)/documents/marketplaceListings/$(id)).data.get('hasHistory',true)==false && request.resource.data.ownerUid==get(/databases/$(database)/documents/marketplaceListings/$(id)).data.ownerUid && getAfter(/databases/$(database)/documents/marketplaceAuditLogs/$(request.resource.data.auditId)).data.targetId==id && getAfter(/databases/$(database)/documents/marketplaceAuditLogs/$(request.resource.data.auditId)).data.action=='listing-deleted';allow update,delete: if false;}
  function boundedReason(d){return d.reason is string && d.reason.trim().size()>=3 && d.reason.size()<=500 && !d.reason.matches('[\\s\\p{Z}]*');}
  function requestParent(d,id){let p=getAfter(/databases/$(database)/documents/marketplaceListings/$(d.listingId)).data;return p.hasHistory==true && p.historyRequestId==id && p.status=='active' && (d.type=='report'||(p.ownerUid==request.auth.uid && editable(p)));}
  function commercial(d){let c=d.data;return c is map && c.keys().hasOnly(['title','advertiserName','description','cta','image','targetUrl','countryTarget','placement','startAt','endAt','priority']) && c.title is string && c.title.size()>0 && c.title.size()<=100 && c.advertiserName is string && c.advertiserName.size()>0 && c.advertiserName.size()<=100 && c.description is string && c.description.size()<=500 && c.cta is string && c.cta.size()>0 && c.cta.size()<=50 && image(c.image) && c.image.size()<=110000 && c.targetUrl is string && c.targetUrl.size()<=2000 && (c.targetUrl=='' || c.targetUrl.matches('^https://[^/@ \\t\\r\\n]+[./][^@ \\t\\r\\n]*$')) && c.countryTarget in ['ALL','AE','SA','EG','OM','JO','MA'] && c.placement in ['hero','hero_side_1','hero_side_2','hero_side_3','middle','footer_1','footer_2','footer_3','footer_4','footer_5'] && c.startAt is number && c.endAt is number && c.endAt>c.startAt && c.endAt-c.startAt<=31536000000 && c.priority is int && c.priority>=1 && c.priority<=10;}
  function requestCreate(d,id){return d.ownerUid==request.auth.uid && d.createdAt==request.time && ((d.type=='bump' && d.keys().hasOnly(['type','ownerUid','listingId','status','reason','createdAt']) && d.status=='pending' && d.reason=='' && requestParent(d,id)) || (d.type=='featured' && d.keys().hasOnly(['type','ownerUid','listingId','status','reason','featuredDurationDays','featuredStartAt','featuredEndAt','createdAt']) && d.status=='pending' && d.reason=='' && d.featuredDurationDays is int && d.featuredDurationDays>=1 && d.featuredDurationDays<=365 && d.featuredStartAt is number && d.featuredEndAt-d.featuredStartAt==d.featuredDurationDays*86400000 && requestParent(d,id)) || (d.type=='report' && d.keys().hasOnly(['type','ownerUid','listingId','targetType','targetUid','reason','status','createdAt']) && d.status=='open' && boundedReason(d) && (('listingId' in d && !d.keys().hasAny(['targetUid','targetType']) && requestParent(d,id)) || (!('listingId' in d) && d.targetType=='user' && d.targetUid is string && exists(/databases/$(database)/documents/users/$(d.targetUid))))) || (d.type=='commercial' && d.keys().hasOnly(['type','ownerUid','status','createdAt','data']) && d.status=='pending' && commercial(d)));}
  function activated(d,id){let p=getAfter(/databases/$(database)/documents/marketplaceListings/$(d.listingId)).data;return d.type=='bump'?(p.bumpRequestId==id && p.bumpedAt==request.time && p.updatedAt==request.time):p.featured==true && p.featuredStatus=='approved' && p.featuredRequestId==id && p.updatedAt==request.time && p.featuredEndAt>p.featuredStartAt;}
  function decision(d,id){return d.diff(resource.data).affectedKeys().hasOnly(['status','auditId','updatedAt']) && d.updatedAt==request.time && ((resource.data.type in ['featured','bump'] && owner() && resource.data.status=='pending' && d.status in ['approved','rejected'] && (d.status=='rejected'||activated(d,id)) && audit(d,'marketplaceRequests',id,'service-'+d.status,d.status)) || (resource.data.type=='commercial' && owner() && ((resource.data.status=='pending' && d.status in ['approved','rejected']) || (resource.data.status=='approved' && d.status in ['paused','rejected']) || (resource.data.status=='paused' && d.status=='approved')) && (d.status!='approved'||d.data.endAt>request.time.toMillis()) && audit(d,'marketplaceRequests',id,'commercial-'+d.status,d.status)) || (resource.data.type=='report' && permit('reports_manage') && resource.data.status in ['open','reviewing','escalated'] && d.status in ['reviewing','dismissed','escalated','resolved'] && audit(d,'marketplaceRequests',id,'report-'+d.status,d.status)));}

  function currentCampaign(d){return d.status=='approved' && d.startAt<=request.time.toMillis() && d.endAt>request.time.toMillis();}
  function publishedCampaign(d,id){let r=getAfter(/databases/$(database)/documents/marketplaceRequests/$(id)).data;return owner() && r.type=='commercial' && r.status==d.status && r.auditId==d.auditId && r.updatedAt==request.time && d.updatedAt==request.time && d.requestId==id && d.ownerUid==r.ownerUid && d.keys().hasOnly(['title','advertiserName','description','cta','targetUrl','placement','countryTarget','startAt','endAt','priority','status','ownerUid','requestId','updatedAt','auditId']) && d.title==r.data.title && d.advertiserName==r.data.advertiserName && d.description==r.data.description && d.cta==r.data.cta && d.targetUrl==r.data.targetUrl && d.placement==r.data.placement && d.countryTarget==r.data.countryTarget && d.startAt==r.data.startAt && d.endAt==r.data.endAt && d.priority==r.data.priority && commercial(r) && r.data.image.size()<=110000;}
  function campaignPublicationLinked(d,id){let p=getAfter(/databases/$(database)/documents/marketplaceCommercialAds/$(id)).data;let i=getAfter(/databases/$(database)/documents/marketplaceCommercialImages/$(id)).data;return p.status==d.status && p.auditId==d.auditId && p.updatedAt==request.time && i.updatedAt==request.time && i.imageData==d.data.image;}
  function commercialDecision(d,id){return owner() && resource.data.type=='commercial' && d.type=='commercial' && d.ownerUid==resource.data.ownerUid && d.createdAt==resource.data.createdAt && d.updatedAt==request.time && commercial(d) && d.data.image.size()<=110000 && (d.status!='approved'||d.data.endAt>request.time.toMillis()) && ((d.diff(resource.data).affectedKeys().hasOnly(['status','auditId','updatedAt']) && ((resource.data.status=='pending' && d.status in ['approved','rejected']) || (resource.data.status=='approved' && d.status in ['paused','rejected']) || (resource.data.status=='paused' && d.status in ['approved','rejected'])) && audit(d,'marketplaceRequests',id,'commercial-'+d.status,d.status)) || (d.diff(resource.data).affectedKeys().hasOnly(['data','auditId','updatedAt']) && audit(d,'marketplaceRequests',id,'commercial-edited','edited'))) && ((d.status!='approved' && !exists(/databases/$(database)/documents/marketplaceCommercialAds/$(id))) || campaignPublicationLinked(d,id));}
  match /marketplaceCommercialAds/{id}{
   allow read: if currentCampaign(resource.data) || owner();
   allow create,update: if publishedCampaign(request.resource.data,id);
   allow delete: if false;
  }
  match /marketplaceCommercialImages/{id}{
   allow get: if currentCampaign(get(/databases/$(database)/documents/marketplaceCommercialAds/$(id)).data) || owner();
   allow list,delete: if false;
   allow create,update: if owner() && request.resource.data.keys().hasOnly(['imageData','updatedAt']) && request.resource.data.updatedAt==request.time && image(request.resource.data.imageData) && request.resource.data.imageData.size()<=110000 && getAfter(/databases/$(database)/documents/marketplaceRequests/$(id)).data.data.image==request.resource.data.imageData && getAfter(/databases/$(database)/documents/marketplaceRequests/$(id)).data.updatedAt==request.time && getAfter(/databases/$(database)/documents/marketplaceCommercialAds/$(id)).data.updatedAt==request.time;
  }

  match /marketplaceRequests/{id}{
   allow read: if active() && (resource.data.ownerUid==request.auth.uid || (resource.data.type=='report' && (permit('reports_view')||permit('reports_manage'))) || (resource.data.type in ['featured','bump','commercial'] && (permit('services_view')||owner())));
   allow create: if active() && requestCreate(request.resource.data,id);
   allow update: if active() && (resource.data.type=='commercial'?commercialDecision(request.resource.data,id):decision(request.resource.data,id));
   allow delete: if false;
  }
  match /marketplaceAuditLogs/{id}{
   allow read: if permit('admin_log_view');
   allow create: if active() && request.resource.data.keys().hasOnly(['actorUid','action','targetId','targetCollection','reason','timestamp','result']) && request.resource.data.actorUid==request.auth.uid && boundedReason(request.resource.data) && request.resource.data.timestamp==request.time && request.resource.data.action is string && request.resource.data.result is string && ((request.resource.data.targetCollection=='marketplaceListings' && permit('listings_manage') && ((existsAfter(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.targetId)) && getAfter(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.targetId)).data.auditId==id) || (owner() && existsAfter(/databases/$(database)/documents/marketplaceDeletions/$(request.resource.data.targetId)) && getAfter(/databases/$(database)/documents/marketplaceDeletions/$(request.resource.data.targetId)).data.auditId==id && getAfter(/databases/$(database)/documents/marketplaceDeletions/$(request.resource.data.targetId)).data.timestamp==request.time))) || (request.resource.data.targetCollection=='marketplaceRequests' && (owner()||permit('reports_manage')) && getAfter(/databases/$(database)/documents/marketplaceRequests/$(request.resource.data.targetId)).data.auditId==id) || (request.resource.data.targetCollection in ['marketplaceCategories','marketplaceSettings','marketplaceCities'] && owner() && getAfter(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId)).data.auditId==id));
   allow update,delete: if false;
  }
  match /marketplaceCategories/{id}{
   allow read: if true;
   allow create,update: if id in ['livestock','cars','phones','computers','appliances','furniture','tools','sports','children','other'] && owner() && request.resource.data.keys().hasOnly(['enabled','order','featured','icon','updatedAt','auditId']) && request.resource.data.enabled is bool && request.resource.data.featured is bool && request.resource.data.order is int && request.resource.data.order>=0 && request.resource.data.order<=99 && request.resource.data.icon in ['car','phone','computer','appliance','sofa','tool','bike','baby','grid','camel'] && request.resource.data.updatedAt==request.time && audit(request.resource.data,'marketplaceCategories',id,'category-update','updated');
   allow delete: if false;
  }
  function settingData(d){return d.keys().hasOnly(['enabledCountries','supportText','updatedAt','auditId']) && d.enabledCountries is list && d.enabledCountries.size()>=1 && d.enabledCountries.size()<=6 && d.enabledCountries.toSet().size()==d.enabledCountries.size() && d.enabledCountries.hasOnly(['AE','SA','EG','OM','JO','MA']) && d.supportText is string && d.supportText.size()<=500;}
  function cityData(d){return d.keys().hasOnly(['country','region','name','enabled','updatedAt','auditId']) && d.country in ['AE','SA','EG','OM','JO','MA'] && d.region is string && d.region.trim().size()>0 && d.region.size()<=100 && d.name is string && d.name.trim().size()>0 && d.name.size()<=100 && d.enabled is bool;}
  match /marketplaceSettings/{id}{allow read: if id=='public';allow create,update: if id=='public' && owner() && settingData(request.resource.data) && request.resource.data.updatedAt==request.time && audit(request.resource.data,'marketplaceSettings',id,'settings-update','updated');allow delete: if false;}
  match /marketplaceCities/{id}{allow read: if true;allow create,update: if owner() && cityData(request.resource.data) && request.resource.data.updatedAt==request.time && audit(request.resource.data,'marketplaceCities',id,'city-update','updated');allow delete: if false;}
  // Read support for the real auth adapter; role/registry writes stay unavailable in this proposal.
  match /users/{uid}{allow read: if request.auth!=null && (request.auth.uid==uid || permit('users_view'));allow write: if false;}
  match /adminAccess/{uid}{allow read: if request.auth!=null && (request.auth.uid==uid || permit('assistants_view'));allow write: if false;}
  match /adminSecurity/{id}{allow get: if request.auth!=null && id=='config';allow list,write: if false;}
 }
}
