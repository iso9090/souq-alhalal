rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Commercial content is separate from livestock. Advertiser contacts are never public.
    function commercialOwner() { return isAdmin() && delegationReady(); }
    function validCommercialAd() {
      let d=request.resource.data;
      return d.keys().hasOnly(['title','advertiserName','description','cta','imageUrl','targetUrl','placement','priority','status','startAt','endAt','createdAt','updatedAt','createdBy','updatedBy','approvedAt','approvedBy','imageStorage','imageVersion'])
        && d.title is string && d.title.size()>0 && d.title.size()<=120
        && d.advertiserName is string && d.advertiserName.size()<=120
        && d.description is string && d.description.size()<=300 && d.cta is string && d.cta.size()<=40
        && ((d.get('imageStorage','')=='' && d.imageUrl is string && d.imageUrl.size()<=2000 && d.imageUrl.matches('https://res[.]cloudinary[.]com/[a-zA-Z0-9_./,%:-]+'))
          || (d.get('imageStorage','')=='firestore' && d.imageUrl=='' && d.imageVersion is string && d.imageVersion.matches('[a-zA-Z0-9-]{1,64}')))
        && d.targetUrl is string && d.targetUrl.size()<=2000 && d.targetUrl.matches('https://[^ @/]+(/[^ ]*)?')
        && d.placement in ['hero','hero_side_1','hero_side_2','hero_side_3','middle','footer_1','footer_2','footer_3','footer_4','footer_5']
        && d.status in ['draft','pending','approved','active','paused','rejected','expired']
        && d.priority is int && d.priority>=0 && d.priority<=999
        && d.startAt is timestamp && d.endAt is timestamp && d.endAt>d.startAt
        && d.createdAt is timestamp && d.updatedAt==request.time && d.createdBy is string && d.updatedBy==request.auth.uid
        && (d.status in ['approved','active'] ? d.approvedBy==request.auth.uid && d.approvedAt==request.time : d.approvedBy=='' && d.approvedAt==null);
    }
    function imageLinkedAfter(id) {
      let ad=getAfter(/databases/$(database)/documents/commercialAds/$(id)).data;
      return ad.get('imageStorage','')!='firestore' || getAfter(/databases/$(database)/documents/commercialAdImages/$(id)).data.version==ad.imageVersion;
    }
    function validCommercialImage(id) {
      let d=request.resource.data;
      return d.keys().hasAll(['adId','imageData','mimeType','bytes','width','height','updatedAt','version'])
        && d.keys().hasOnly(['adId','imageData','mimeType','bytes','width','height','updatedAt','version'])
        && d.adId==id && d.mimeType=='image/jpeg'
        && d.bytes is int && d.bytes>0 && d.bytes<=61440
        && d.width is int && d.width>0 && d.width<=1200 && d.height is int && d.height>0 && d.height<=1200
        && d.imageData is string && d.imageData.size()<=81943
        && d.imageData.matches('data:image/jpeg;base64,/9j/[A-Za-z0-9+/]*={0,2}')
        && d.imageData.size()>=23+d.bytes * 4 / 3 && d.imageData.size()<27+d.bytes * 4 / 3
        && d.updatedAt==request.time && d.version is string && d.version.matches('[a-zA-Z0-9-]{1,64}')
        && getAfter(/databases/$(database)/documents/commercialAds/$(id)).data.imageStorage=='firestore'
        && getAfter(/databases/$(database)/documents/commercialAds/$(id)).data.imageVersion==d.version;
    }
    match /commercialAdImages/{id} {
      allow get: if commercialOwner() || (get(/databases/$(database)/documents/commercialAds/$(id)).data.status=='active'
        && get(/databases/$(database)/documents/commercialAds/$(id)).data.startAt<=request.time
        && get(/databases/$(database)/documents/commercialAds/$(id)).data.endAt>=request.time);
      allow list: if false;
      allow create,update: if commercialOwner() && validCommercialImage(id);
      // Paused ads retain their private image for reactivation. Delete only after detaching.
      allow delete: if commercialOwner() && (!existsAfter(/databases/$(database)/documents/commercialAds/$(id))
        || getAfter(/databases/$(database)/documents/commercialAds/$(id)).data.get('imageStorage','')!='firestore');
    }
    match /commercialAds/{id} {
      allow read: if commercialOwner() || (resource.data.status=='active' && resource.data.startAt<=request.time && resource.data.endAt>=request.time);
      allow create: if commercialOwner() && validCommercialAd() && imageLinkedAfter(id) && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid;
      allow update: if commercialOwner() && validCommercialAd() && imageLinkedAfter(id) && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.createdBy==resource.data.createdBy;
      allow delete: if false;
    }
    match /commercialAdContacts/{id} {
      allow read: if commercialOwner();
      allow create,update: if commercialOwner() && request.resource.data.keys().hasOnly(['advertiserEmail','advertiserPhone'])
        && request.resource.data.advertiserEmail is string && request.resource.data.advertiserEmail.size()<=254
        && request.resource.data.advertiserPhone is string && request.resource.data.advertiserPhone.size()<=40;
      allow delete: if false;
    }
    match /platformTelemetry/{id} {
      allow get: if id=='config'; allow list: if false;
      allow create,update: if id=='config' && commercialOwner() && request.resource.data.keys().hasOnly(['enabled','updatedAt','updatedBy'])
        && request.resource.data.enabled is bool && request.resource.data.updatedAt==request.time && request.resource.data.updatedBy==request.auth.uid;
      allow delete: if false;
    }
    function telemetryOn(){return false && exists(/databases/$(database)/documents/platformTelemetry/config) && get(/databases/$(database)/documents/platformTelemetry/config).data.enabled==true;}
    function boundedEvents(v){return v is list && v.size()<=20 && v.toSet().size()==v.size()
      && (v.size()==0 || (v.join(',').matches('[a-zA-Z0-9_-]{1,128}(,[a-zA-Z0-9_-]{1,128}){0,19}') && v.join(',').split(',')==v));}
    function validSession(){
      let d=request.resource.data;let p=d.pages;
      return d.keys().hasOnly(['startedAt','updatedAt','pageViews','pages','views','clicks']) && d.startedAt is timestamp && d.updatedAt==request.time
        && p.keys().hasOnly(['home','market','services','admin','other'])
        && p.home is int && p.home>=0 && p.market is int && p.market>=0 && p.services is int && p.services>=0 && p.admin is int && p.admin>=0 && p.other is int && p.other>=0
        && d.pageViews is int && d.pageViews>=1 && d.pageViews<=1000 && d.pageViews==p.home+p.market+p.services+p.admin+p.other
        && boundedEvents(d.views) && boundedEvents(d.clicks) && d.views.hasAll(d.clicks);
    }
    match /analyticsSessions/{id} {
      allow read: if commercialOwner();
      // Legacy mutable counters remain read-only. New collection is append-only.
      allow create,update: if false;
      allow delete: if false;
    }

    function validAnalyticsEvent(id) {
      let d=request.resource.data;
      return d.keys().hasOnly(['sessionId','sequence','sessionStartedAt','occurredAt','kind','category','adId'])
        && d.sessionId is string && d.sessionId.matches('[a-f0-9]{32}')
        && d.sequence is int && d.sequence>=0 && d.sequence<100
        && id==d.sessionId+'_'+string(d.sequence)
        && d.sessionStartedAt is timestamp && d.sessionStartedAt<=request.time && d.sessionStartedAt>=request.time-duration.value(24,'h')
        && d.occurredAt==request.time
        && d.kind in ['page','views','clicks']
        && d.category in ['home','market','listing_details','sell','auctions','services','account','contact','about','other']
        && d.adId is string && (d.kind=='page'?d.adId=='':d.adId.matches('[a-zA-Z0-9_-]{1,128}'));
    }
    function followsAnalyticsEvent() {
      let d=request.resource.data;
      let previousId=d.sessionId+'_'+string(d.sequence-1);
      let p=get(/databases/$(database)/documents/analyticsEvents/$(previousId)).data;
      return p.sessionStartedAt==d.sessionStartedAt && request.time>=p.occurredAt
        && request.time<p.occurredAt+duration.value(30,'m')
        && (request.time+duration.value(4,'h')).date()==(p.occurredAt+duration.value(4,'h')).date()
        && !(d.kind=='page' && p.kind=='page' && p.category==d.category);
    }
    match /analyticsEvents/{id} {
      allow read: if commercialOwner();
      allow create: if telemetryOn() && validAnalyticsEvent(id)
        && (request.resource.data.sequence==0
          ? request.resource.data.kind=='page' && request.resource.data.sessionStartedAt>=request.time-duration.value(5,'m')
          : followsAnalyticsEvent());
      allow update,delete: if false;
    }
    match /analyticsDaily/{id} { allow read: if commercialOwner(); allow write: if false; }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return activeAccount() && request.auth.token.get('admin', false) == true
        && (!exists(/databases/$(database)/documents/adminSecurity/config)
          || request.auth.uid in get(/databases/$(database)/documents/adminSecurity/config).data.superAdminUids);
    }

    // Legacy signed custom claim remains the trusted Super Admin authority.
    // Registry/config can only be bootstrapped by an explicitly authorized trusted environment.
    function delegationReady() {
      return exists(/databases/$(database)/documents/adminSecurity/config)
        && get(/databases/$(database)/documents/adminSecurity/config).data.enabled == true
        && get(/databases/$(database)/documents/adminSecurity/config).data.superAdminUids is list
        && get(/databases/$(database)/documents/adminSecurity/config).data.superAdminUids.size() > 0;
    }
    function assistantAccess() { return get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data; }
    function hasPermission(permission) {
      return isAdmin() || (activeAccount() && delegationReady()
        && exists(/databases/$(database)/documents/adminAccess/$(request.auth.uid))
        && assistantAccess().role == 'admin_assistant' && assistantAccess().adminStatus == 'active'
        && permission in assistantAccess().permissions);
    }
    function protectedAccount(uid) {
      return (exists(/databases/$(database)/documents/adminSecurity/config) && uid in get(/databases/$(database)/documents/adminSecurity/config).data.get('superAdminUids', []))
        || (exists(/databases/$(database)/documents/adminAccess/$(uid))
          && get(/databases/$(database)/documents/adminAccess/$(uid)).data.role == 'super_admin');
    }
    function assistantAccount(uid) {
      return exists(/databases/$(database)/documents/adminAccess/$(uid))
        && get(/databases/$(database)/documents/adminAccess/$(uid)).data.role == 'admin_assistant';
    }
    function mayManageUser(uid) {
      return !protectedAccount(uid) && (isAdmin() || (delegationReady() && uid != request.auth.uid && !assistantAccount(uid)));
    }
    function userActionPermission() {
      return hasPermission(request.resource.data.status == 'suspended' ? 'users_suspend'
        : request.resource.data.status == 'blocked' ? 'users_block' : 'users_manage');
    }
    function validPermissions(values) {
      return values is list && values.size() <= 21 && values.toSet().size() == values.size()
        && values.hasOnly(['dashboard_view', 'users_view', 'users_suspend', 'users_block', 'users_manage', 'listings_view', 'listings_manage', 'auctions_view', 'auctions_manage', 'purchase_requests_view', 'purchase_requests_manage', 'reports_view', 'reports_manage', 'services_view', 'services_manage', 'admin_log_view', 'assistants_view', 'assistants_create', 'assistants_edit_permissions', 'assistants_suspend', 'assistants_remove_role']);
    }
    function canDelegate(uid, permission, oldPermissions, newPermissions) {
      return delegationReady() && isAdmin() && uid != request.auth.uid && !protectedAccount(uid);
    }
    function assistantAudit(uid, action, oldPermissions) {
      let log = getAfter(/databases/$(database)/documents/adminAuditLogs/$(request.resource.data.moderationLogId)).data;
      return validAudit('adminAccess',uid) && log.action == action
        && log.metadata.oldPermissions == oldPermissions && log.metadata.newPermissions == request.resource.data.permissions;
    }
    function validAssistantData() {
      let d=request.resource.data;
      return d.keys().hasOnly(['role','adminStatus','permissions','createdByAdminUid','adminCreatedAt','adminUpdatedAt','moderationLogId'])
        && d.role in ['admin_assistant','removed'] && d.adminStatus in ['active','suspended']
        && validPermissions(d.permissions) && d.adminUpdatedAt == request.time
        && d.createdByAdminUid is string && d.adminCreatedAt is timestamp && d.moderationLogId is string;
    }
    function assistantLogPermission(action) {
      return action == 'assistant_created' ? 'assistants_create'
        : action == 'assistant_permissions_updated' ? 'assistants_edit_permissions'
        : action in ['assistant_suspended','assistant_reactivated'] ? 'assistants_suspend'
        : action == 'assistant_role_removed' ? 'assistants_remove_role' : 'invalid';
    }
    function canWriteAudit(data) {
      return isAdmin() || (data.targetType == 'users' && mayManageUser(data.targetId)
          && hasPermission(data.action == 'تعليق الحساب' ? 'users_suspend' : data.action == 'حظر الحساب' ? 'users_block' : 'users_manage'))
        || (data.targetType == 'animals' && hasPermission('listings_manage'))
        || (data.targetType == 'auctions' && hasPermission('auctions_manage'))
        || (data.targetType == 'purchaseRequests' && hasPermission('purchase_requests_manage'))
        || (data.targetType == 'reports' && hasPermission('reports_manage'))
        || (data.targetType == 'serviceRequests' && hasPermission('services_manage'))
        || (data.targetType == 'accountDeletionRequests' && hasPermission('users_manage') && mayManageUser(data.targetId))
        || (data.targetType == 'adminAccess' && delegationReady() && isAdmin());
    }
    match /adminSecurity/{id} { allow read: if signedIn(); allow write: if false; }
    match /adminAccess/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || hasPermission('assistants_view') || hasPermission('assistants_create') || hasPermission('assistants_edit_permissions'));
      allow list: if hasPermission('assistants_view');
      allow create: if validAssistantData() && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.role == 'admin_assistant' && request.resource.data.adminStatus == 'active'
        && request.resource.data.createdByAdminUid == request.auth.uid && request.resource.data.adminCreatedAt == request.time
        && canDelegate(uid,'assistants_create',[],request.resource.data.permissions) && assistantAudit(uid,'assistant_created',[]);
      allow update: if validAssistantData() && resource.data.role in ['admin_assistant','removed'] && (
        (resource.data.role == 'removed' && request.resource.data.role == 'admin_assistant'
          && request.resource.data.adminStatus == 'active' && request.resource.data.createdByAdminUid == request.auth.uid
          && request.resource.data.adminCreatedAt == request.time
          && canDelegate(uid,'assistants_create',resource.data.permissions,request.resource.data.permissions)
          && assistantAudit(uid,'assistant_created',resource.data.permissions))
        || (resource.data.role == 'admin_assistant' && request.resource.data.adminCreatedAt == resource.data.adminCreatedAt
          && request.resource.data.createdByAdminUid == resource.data.createdByAdminUid && (
          (changedKeysOnly(['permissions','adminUpdatedAt','moderationLogId'])
            && canDelegate(uid,'assistants_edit_permissions',resource.data.permissions,request.resource.data.permissions)
            && assistantAudit(uid,'assistant_permissions_updated',resource.data.permissions))
          || (changedKeysOnly(['adminStatus','adminUpdatedAt','moderationLogId'])
            && request.resource.data.adminStatus != resource.data.adminStatus
            && canDelegate(uid,'assistants_suspend',resource.data.permissions,request.resource.data.permissions)
            && assistantAudit(uid,request.resource.data.adminStatus == 'active' ? 'assistant_reactivated' : 'assistant_suspended',resource.data.permissions))
          || (changedKeysOnly(['role','adminStatus','permissions','adminUpdatedAt','moderationLogId'])
            && request.resource.data.role == 'removed' && request.resource.data.adminStatus == 'suspended' && request.resource.data.permissions.size() == 0
            && canDelegate(uid,'assistants_remove_role',resource.data.permissions,[])
            && assistantAudit(uid,'assistant_role_removed',resource.data.permissions))
        )));
      allow delete: if false;
    }

    function activeAccount() {
      return signedIn() && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active');
    }
    function validAudit(kind, id) {
      let log = getAfter(/databases/$(database)/documents/adminAuditLogs/$(request.resource.data.moderationLogId)).data;
      return log.adminUid == request.auth.uid && log.targetType == kind && log.targetId == id && log.timestamp == request.time;
    }
    function isOwner(fieldName) {
      return activeAccount() && resource.data[fieldName] == request.auth.uid;
    }

    function changedKeysOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function hasNoVerificationFields(data) {
      return !data.keys().hasAny([
        'verificationStatus',
        'verificationRequestedAt',
        'verificationRequestedBy',
        'verificationReviewedAt',
        'verificationReviewedBy',
        'verificationNotes',
        'verificationRejectionReason',
        'verifiedAt',
        'verifiedBy',
        'isVerified',
        'verification',
        'rejectedAt',
        'rejectedBy'
      ]);
    }

    function verificationFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'verificationStatus',
        'verificationRequestedAt',
        'verificationRequestedBy',
        'verificationReviewedAt',
        'verificationReviewedBy',
        'verificationNotes',
        'verificationRejectionReason',
        'verifiedAt',
        'verifiedBy',
        'isVerified',
        'verification',
        'rejectedAt',
        'rejectedBy'
      ]);
    }

    function hasNoPromotionFields(data) {
      return !data.keys().hasAny([
        'featuredAt',
        'featuredUntil',
        'bumpedAt'
      ]);
    }

    function promotionFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'featuredAt',
        'featuredUntil',
        'bumpedAt'
      ]);
    }

    function effectiveDocumentCountry(data) {
      return data.keys().hasAny(['country']) ? data.country : 'AE';
    }

    function validServicePrice(serviceType, country, amount, currency) {
      return (
        country == 'AE'
        && currency == 'AED'
        && (
          (serviceType == 'featured' && amount == 15)
          || (serviceType == 'bump' && amount == 7)
          || (serviceType == 'verification' && amount == 25)
        )
      ) || (
        country == 'EG'
        && currency == 'EGP'
        && (
          (serviceType == 'featured' && amount == 200)
          || (serviceType == 'bump' && amount == 100)
          || (serviceType == 'verification' && amount == 350)
        )
      );
    }

    function effectivePaymentStatus(data) {
      return data.keys().hasAny(['paymentStatus']) ? data.paymentStatus : 'unpaid';
    }

    function validPaymentOverrideReason(reason) {
      return reason in ['تجريبي', 'مجاني', 'تعويض', 'عرض ترويجي', 'قرار إداري', 'أخرى'];
    }

    function hasValidServiceApprovalPayment(data) {
      return (
        effectivePaymentStatus(data) == 'paid'
        && !data.keys().hasAny([
          'paymentOverride', 'paymentOverrideBy', 'paymentOverrideAt', 'paymentOverrideReason'
        ])
      ) || (
        effectivePaymentStatus(data) == 'unpaid'
        && data.paymentOverride == true
        && data.paymentOverrideBy == request.auth.uid
        && data.paymentOverrideAt == request.time
        && data.paymentOverrideReason is string
        && validPaymentOverrideReason(data.paymentOverrideReason)
      );
    }

    function conversationIsParticipant(conversationId) {
      return activeAccount()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participants;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasPermission('users_view') || hasPermission('assistants_create') || hasPermission('assistants_edit_permissions')
        || (hasPermission('assistants_view') && exists(/databases/$(database)/documents/adminAccess/$(uid))));

      allow create: if activeAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'displayName',
          'accountType',
          'status',
          'createdAt',
          'lastLoginAt',
          'email', 'phone', 'authProvider'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'active'
        && request.resource.data.accountType in ['buyer', 'seller', 'both']
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time
        // Optional Google metadata is accepted only from the authenticated identity.
        // Legacy phone/email creation is unchanged. These fields grant no permissions.
        && (!request.resource.data.keys().hasAny(['email', 'phone', 'authProvider']) || (
          request.resource.data.keys().hasAll(['email', 'phone', 'authProvider'])
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.resource.data.authProvider == 'google'
          && request.resource.data.accountType == 'buyer'
          && request.resource.data.email is string
          && request.resource.data.email == request.auth.token.get('email', '')
          && request.resource.data.phone is string
          && request.resource.data.phone == request.auth.token.get('phone_number', '')
        ));

      allow update: if activeAccount()
        && request.auth.uid == uid
        && changedKeysOnly([
          'phoneNumber',
          'displayName',
          'accountType',
          'lastLoginAt',
          'updatedAt'
        ])
        && (
          !request.resource.data.keys().hasAny(['accountType'])
          || request.resource.data.accountType in ['buyer', 'seller', 'both']
        );

      allow update: if userActionPermission() && mayManageUser(uid) && uid != request.auth.uid
        && changedKeysOnly(['status', 'moderationLogId'])
        && request.resource.data.status in ['active','suspended','blocked','deletion_requested']
        && validAudit('users', uid);
      allow delete: if false;
    }

    function validListingImages(data) {
      return data.images is list && data.images.size() >= 1 && data.images.size() <= 3
        && data.images.toSet().size() == data.images.size()
        && data.images[0] is string && data.images[0].size() > 0
        && (data.images.size() < 2 || (data.images[1] is string && data.images[1].size() > 0))
        && (data.images.size() < 3 || (data.images[2] is string && data.images[2].size() > 0));
    }
    match /animals/{animalId} {
      allow read: if true;

      allow create: if activeAccount()
        && validListingImages(request.resource.data)
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.saleType in ['direct', 'auction']
        && request.resource.data.country in ['AE', 'EG']
        && request.resource.data.region is string
        && request.resource.data.region.size() > 0
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && (
          request.resource.data.saleType != 'direct'
          || !request.resource.data.keys().hasAny(['sellerPhone'])
        )
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasNoVerificationFields(request.resource.data)
        && hasNoPromotionFields(request.resource.data)
        && !request.resource.data.keys().hasAny(['imagesLocked','moderationLocked','moderationLogId']);

      allow update: if (
        isOwner('sellerId')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['images']) || validListingImages(request.resource.data))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['imagesLocked','moderationLocked','moderationLogId'])
        && (!resource.data.get('imagesLocked', false) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['images']))
        && (!resource.data.get('moderationLocked', false)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (resource.data.status == 'active'
            && request.resource.data.status in ['sold', 'not_approved']))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'sellerId',
          'saleType',
          'auctionId',
          'createdAt'
        ])
        && (
          (
            resource.data.keys().hasAny(['country'])
            && request.resource.data.country == resource.data.country
          )
          || (
            !resource.data.keys().hasAny(['country'])
            && (
              !request.resource.data.keys().hasAny(['country'])
              || request.resource.data.country == 'AE'
            )
          )
        )
        && (
          !request.resource.data.keys().hasAny(['country'])
          || (
            request.resource.data.country in ['AE', 'EG']
            && request.resource.data.region is string
            && request.resource.data.region.size() > 0
            && request.resource.data.city is string
            && request.resource.data.city.size() > 0
          )
        )
        && (
          request.resource.data.saleType != 'direct'
          || !request.resource.data.keys().hasAny(['sellerPhone'])
        )
        && verificationFieldsUnchanged()
        && promotionFieldsUnchanged()
      ) || (
        hasPermission('services_manage')
        && (
          (
            changedKeysOnly(['featuredAt', 'featuredUntil'])
            && request.resource.data.featuredAt == request.time
            && request.resource.data.featuredUntil is timestamp
            && request.resource.data.featuredUntil > request.time
            && request.resource.data.featuredUntil <= request.time + duration.value(8, 'd')
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_animal_' + animalId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_animal_' + animalId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_animal_' + animalId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_animal_' + animalId)).data.approvedAt == request.time
          )
          || (
            changedKeysOnly(['bumpedAt'])
            && request.resource.data.bumpedAt == request.time
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_animal_' + animalId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_animal_' + animalId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_animal_' + animalId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_animal_' + animalId)).data.approvedAt == request.time
          )
          || (
            changedKeysOnly(['verificationStatus', 'verifiedAt', 'verifiedBy'])
            && request.resource.data.verificationStatus == 'verified'
            && request.resource.data.verifiedAt == request.time
            && request.resource.data.verifiedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_verification_animal_' + animalId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_verification_animal_' + animalId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_verification_animal_' + animalId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_verification_animal_' + animalId)).data.approvedAt == request.time
          )
        )
      );

      allow update: if hasPermission('listings_manage')
        && changedKeysOnly(['images','imagesLocked','moderationLocked','status','moderationLogId'])
        && request.resource.data.moderationLocked == true
        && request.resource.data.status in ['active','hidden','needs_review','sold','not_approved']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['images']) || (
          request.resource.data.images is list
          && request.resource.data.images.size() <= 3
          && request.resource.data.images.size() < resource.data.images.size()
          && request.resource.data.images.toSet().difference(resource.data.images.toSet()).size() == 0
          && request.resource.data.imagesLocked == true
          && (request.resource.data.images.size() > 0 || request.resource.data.status == 'needs_review')))
        && validAudit('animals', animalId);
      allow delete: if isOwner('sellerId') && !resource.data.get('moderationLocked', false);
    }

    match /auctions/{auctionId} {
      allow read: if true;

      allow create: if activeAccount()
        && !request.resource.data.keys().hasAny(['images'])
        && validListingImages(getAfter(/databases/$(database)/documents/animals/$(request.resource.data.animalId)).data)
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.country in ['AE', 'EG']
        && getAfter(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.country == request.resource.data.country
        && getAfter(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.sellerId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.saleType == 'auction'
        && request.resource.data.status == 'active'
        && !request.resource.data.keys().hasAny(['lastBidderId', 'lastBidderPhone', 'lastBidAt', 'winnerId', 'winnerPhone'])
        && request.resource.data.startPrice > 0
        && request.resource.data.startPrice is number
        && request.resource.data.currentPrice == request.resource.data.startPrice
        && request.resource.data.minIncrement is number
        && request.resource.data.minIncrement > 0
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasNoVerificationFields(request.resource.data)
        && hasNoPromotionFields(request.resource.data);

      allow update: if (
        activeAccount()
        && (
          (
            resource.data.keys().hasAny(['country'])
            && request.resource.data.country == resource.data.country
          )
          || (
            !resource.data.keys().hasAny(['country'])
            && (
              !request.resource.data.keys().hasAny(['country'])
              || request.resource.data.country == 'AE'
            )
          )
        )
        && (
        (
          resource.data.sellerId != request.auth.uid
          && resource.data.status == 'active'
          && (!exists(/databases/$(database)/documents/animals/$(resource.data.animalId))
            || get(/databases/$(database)/documents/animals/$(resource.data.animalId)).data.get('status', 'active') == 'active')
          && resource.data.endTime is timestamp
          && request.time < resource.data.endTime
          && changedKeysOnly([
            'currentPrice',
            'lastBidAt',
            'lastBidderId',
            'lastBidderPhone'
          ])
          && request.resource.data.currentPrice is number
          && request.resource.data.currentPrice >=
            resource.data.currentPrice + resource.data.minIncrement
          && request.resource.data.lastBidderId == request.auth.uid
          && request.resource.data.lastBidAt == request.time
        )
        ||
        (
          resource.data.sellerId == request.auth.uid
          && resource.data.status == 'active'
          && resource.data.endTime is timestamp
          && request.time >= resource.data.endTime
          && changedKeysOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['sold', 'not_approved']
          && request.resource.data.updatedAt == request.time
        )
        )
      ) || (
        hasPermission('services_manage')
        && (
          (
            changedKeysOnly(['featuredAt', 'featuredUntil'])
            && request.resource.data.featuredAt == request.time
            && request.resource.data.featuredUntil is timestamp
            && request.resource.data.featuredUntil > request.time
            && request.resource.data.featuredUntil <= request.time + duration.value(8, 'd')
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_auction_' + auctionId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_auction_' + auctionId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_auction_' + auctionId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_featured_auction_' + auctionId)).data.approvedAt == request.time
          )
          || (
            changedKeysOnly(['bumpedAt'])
            && request.resource.data.bumpedAt == request.time
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_auction_' + auctionId)).data.status == 'approved'
            && hasValidServiceApprovalPayment(getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_auction_' + auctionId)).data)
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_auction_' + auctionId)).data.approvedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/serviceRequests/$(resource.data.sellerId + '_bump_auction_' + auctionId)).data.approvedAt == request.time
          )
        )
      );

      allow update: if hasPermission('auctions_manage') && resource.data.status == 'active'
        && resource.data.endTime <= request.time && request.resource.data.status in ['sold','not_approved']
        && changedKeysOnly(['status','updatedAt','moderationLogId']) && request.resource.data.updatedAt == request.time
        && validAudit('auctions',auctionId);
      allow delete: if isOwner('sellerId');
    }

    // Private, existing participation aggregate. A record can only advance with
    // the same successful auction price update; it cannot fabricate past bids.
    match /auctionParticipations/{participationId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/auctionParticipations/$(participationId))
        || resource.data.bidderId == request.auth.uid
      );
      allow list: if signedIn() && resource.data.bidderId == request.auth.uid;

      function validParticipation() {
        let data = request.resource.data;
        let auction = get(/databases/$(database)/documents/auctions/$(data.auctionId)).data;
        let after = getAfter(/databases/$(database)/documents/auctions/$(data.auctionId)).data;
        return data.keys().hasOnly(['auctionId','animalId','sellerId','bidderId','lastBidAmount','lastBidAt','createdAt'])
          && data.bidderId == request.auth.uid
          && participationId == data.auctionId + '_' + request.auth.uid
          && data.animalId == auction.animalId
          && data.sellerId == auction.sellerId
          && auction.sellerId != request.auth.uid
          && auction.status == 'active' && request.time < auction.endTime
          && data.lastBidAmount is number
          && data.lastBidAmount > auction.currentPrice
          && data.lastBidAmount == after.currentPrice
          && after.lastBidderId == request.auth.uid
          && data.lastBidAt == request.time && after.lastBidAt == request.time;
      }
      allow create: if activeAccount() && validParticipation()
        && request.resource.data.createdAt == request.time;
      allow update: if activeAccount() && resource.data.bidderId == request.auth.uid
        && validParticipation()
        && changedKeysOnly(['lastBidAmount','lastBidAt'])
        && request.resource.data.lastBidAmount > resource.data.lastBidAmount;
      allow delete: if false;
    }

    match /serviceRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || hasPermission('services_view'));

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'userId',
          'serviceType',
          'targetType',
          'targetId',
          'country',
          'amount',
          'currency',
          'paymentStatus',
          'status',
          'createdAt',
          'updatedAt',
          'notes',
          'details'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.serviceType in ['featured', 'bump', 'verification']
        && request.resource.data.targetType in ['animal', 'auction']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && requestId == request.auth.uid + '_' + request.resource.data.serviceType
          + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.country in ['AE', 'EG']
        && request.resource.data.amount is number
        && validServicePrice(
          request.resource.data.serviceType,
          request.resource.data.country,
          request.resource.data.amount,
          request.resource.data.currency
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'unpaid'
        && !request.resource.data.keys().hasAny([
          'paymentOverride', 'paymentOverrideBy', 'paymentOverrideAt', 'paymentOverrideReason'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.serviceType != 'verification'
            && !request.resource.data.keys().hasAny(['notes', 'details'])
          )
          || (
            request.resource.data.serviceType == 'verification'
            && request.resource.data.targetType == 'animal'
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 1000
            && request.resource.data.details is map
            && request.resource.data.details.keys().hasOnly([
              'animalIdentifier',
              'vaccinationStatus',
              'vaccinationDate',
              'vetInspectionStatus',
              'vetInspectionDate'
            ])
            && request.resource.data.details.animalIdentifier is string
            && request.resource.data.details.vaccinationStatus is string
            && request.resource.data.details.vaccinationDate is string
            && request.resource.data.details.vetInspectionStatus is string
            && request.resource.data.details.vetInspectionDate is string
          )
        )
        && (
          (
            request.resource.data.targetType == 'animal'
            && exists(/databases/$(database)/documents/animals/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/animals/$(request.resource.data.targetId)).data.sellerId == request.auth.uid
            && (
              request.resource.data.serviceType == 'verification'
              || get(/databases/$(database)/documents/animals/$(request.resource.data.targetId)).data.saleType == 'direct'
            )
            && effectiveDocumentCountry(
              get(/databases/$(database)/documents/animals/$(request.resource.data.targetId)).data
            ) == request.resource.data.country
          )
          || (
            request.resource.data.targetType == 'auction'
            && request.resource.data.serviceType in ['featured', 'bump']
            && exists(/databases/$(database)/documents/auctions/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/auctions/$(request.resource.data.targetId)).data.sellerId == request.auth.uid
            && effectiveDocumentCountry(
              get(/databases/$(database)/documents/auctions/$(request.resource.data.targetId)).data
            ) == request.resource.data.country
          )
        );

      allow update: if (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && changedKeysOnly(['status', 'cancelledAt', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
      ) || (
        hasPermission('services_manage')
        && resource.data.status == 'pending'
        && request.resource.data.updatedAt == request.time
        && (
          (
            changedKeysOnly(['status', 'approvedAt', 'approvedBy', 'updatedAt'])
            && request.resource.data.status == 'approved'
            && effectivePaymentStatus(resource.data) == 'paid'
            && !request.resource.data.keys().hasAny([
              'paymentOverride', 'paymentOverrideBy', 'paymentOverrideAt', 'paymentOverrideReason'
            ])
            && request.resource.data.approvedAt == request.time
            && request.resource.data.approvedBy == request.auth.uid
            && (
              (
                resource.data.targetType == 'animal'
                && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.sellerId == resource.data.userId
                && effectiveDocumentCountry(getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data) == resource.data.country
                && (
                  (
                    resource.data.serviceType == 'featured'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.featuredAt == request.time
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.featuredUntil > request.time
                  )
                  || (
                    resource.data.serviceType == 'bump'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.bumpedAt == request.time
                  )
                  || (
                    resource.data.serviceType == 'verification'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verificationStatus == 'verified'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verifiedAt == request.time
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verifiedBy == request.auth.uid
                  )
                )
              )
              || (
                resource.data.targetType == 'auction'
                && resource.data.serviceType in ['featured', 'bump']
                && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.sellerId == resource.data.userId
                && effectiveDocumentCountry(getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data) == resource.data.country
                && (
                  (
                    resource.data.serviceType == 'featured'
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.featuredAt == request.time
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.featuredUntil > request.time
                  )
                  || (
                    resource.data.serviceType == 'bump'
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.bumpedAt == request.time
                  )
                )
              )
            )
          )
          || (
            changedKeysOnly([
              'status', 'approvedAt', 'approvedBy', 'updatedAt',
              'paymentOverride', 'paymentOverrideBy', 'paymentOverrideAt', 'paymentOverrideReason'
            ])
            && request.resource.data.status == 'approved'
            && effectivePaymentStatus(resource.data) == 'unpaid'
            && request.resource.data.paymentOverride == true
            && request.resource.data.paymentOverrideBy == request.auth.uid
            && request.resource.data.paymentOverrideAt == request.time
            && request.resource.data.paymentOverrideReason is string
            && validPaymentOverrideReason(request.resource.data.paymentOverrideReason)
            && request.resource.data.approvedAt == request.time
            && request.resource.data.approvedBy == request.auth.uid
            && (
              (
                resource.data.targetType == 'animal'
                && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.sellerId == resource.data.userId
                && effectiveDocumentCountry(getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data) == resource.data.country
                && (
                  (
                    resource.data.serviceType == 'featured'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.featuredAt == request.time
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.featuredUntil > request.time
                  )
                  || (
                    resource.data.serviceType == 'bump'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.bumpedAt == request.time
                  )
                  || (
                    resource.data.serviceType == 'verification'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verificationStatus == 'verified'
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verifiedAt == request.time
                    && getAfter(/databases/$(database)/documents/animals/$(resource.data.targetId)).data.verifiedBy == request.auth.uid
                  )
                )
              )
              || (
                resource.data.targetType == 'auction'
                && resource.data.serviceType in ['featured', 'bump']
                && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.sellerId == resource.data.userId
                && effectiveDocumentCountry(getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data) == resource.data.country
                && (
                  (
                    resource.data.serviceType == 'featured'
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.featuredAt == request.time
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.featuredUntil > request.time
                  )
                  || (
                    resource.data.serviceType == 'bump'
                    && getAfter(/databases/$(database)/documents/auctions/$(resource.data.targetId)).data.bumpedAt == request.time
                  )
                )
              )
            )
          )
          || (
            changedKeysOnly(['status', 'rejectedAt', 'rejectedBy', 'updatedAt', 'adminNote'])
            && request.resource.data.status == 'rejected'
            && request.resource.data.rejectedAt == request.time
            && request.resource.data.rejectedBy == request.auth.uid
            && (
              !request.resource.data.keys().hasAny(['adminNote'])
              || (
                request.resource.data.adminNote is string
                && request.resource.data.adminNote.size() <= 1000
              )
            )
          )
        )
      );

      allow delete: if false;
    }

    match /purchaseRequests/{requestId} {
      allow read: if signedIn()
        && (
          hasPermission('purchase_requests_view') || resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        );

      allow create: if activeAccount()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        )
        && get(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.sellerId == request.resource.data.sellerId
        && get(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.price == request.resource.data.price
        && get(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.saleType == 'direct'
        && get(
          /databases/$(database)/documents/animals/$(request.resource.data.animalId)
        ).data.status == 'active';

      allow update: if activeAccount()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'pending'
        && changedKeysOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.updatedAt == request.time;

      allow update: if hasPermission('purchase_requests_manage') && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted','rejected'] && changedKeysOnly(['status','updatedAt','moderationLogId'])
        && request.resource.data.updatedAt == request.time && validAudit('purchaseRequests',requestId);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (
          (
            !exists(
              /databases/$(database)/documents/conversations/$(conversationId)
            )
            && conversationId.matches(
              '^direct_.+_' + request.auth.uid + '$'
            )
          )
          || request.auth.uid in resource.data.participants
        );

      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if activeAccount()
        && request.resource.data.contextType == 'direct'
        && !request.resource.data.keys().hasAny(['contactStatus', 'acceptedOfferId', 'contactUnlockedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.sellerId != request.resource.data.buyerId
        && request.resource.data.participants.hasAll([
          request.resource.data.sellerId,
          request.resource.data.buyerId
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastMessageType == ''
        && request.resource.data.lastMessageSenderId == ''
        && request.resource.data.sellerUnread == 0
        && request.resource.data.buyerUnread == 0
        && (
          (
            request.resource.data.contextType == 'direct'
            && request.auth.uid == request.resource.data.buyerId
            && exists(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            )
            && get(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            ).data.saleType == 'direct'
            && get(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            ).data.status == 'active'
            && get(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            ).data.sellerId == request.resource.data.sellerId
            && get(
              /databases/$(database)/documents/animals/$(request.resource.data.animalId)
            ).data.price == request.resource.data.askingPrice
          )
          ||
          (
            request.resource.data.contextType == 'auction'
            && exists(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            )
            && get(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            ).data.status == 'sold'
            && get(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            ).data.sellerId == request.resource.data.sellerId
            && get(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            ).data.lastBidderId == request.resource.data.buyerId
            && get(
              /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
            ).data.animalId == request.resource.data.animalId
            && (
              (
                get(
                  /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
                ).data.keys().hasAny(['currentPrice'])
                && get(
                  /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
                ).data.currentPrice == request.resource.data.finalPrice
              )
              ||
              (
                !get(
                  /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
                ).data.keys().hasAny(['currentPrice'])
                && get(
                  /databases/$(database)/documents/auctions/$(request.resource.data.auctionId)
                ).data.startPrice == request.resource.data.finalPrice
              )
            )
            && request.auth.uid in request.resource.data.participants
          )
        );

      allow update: if activeAccount()
        && request.auth.uid in resource.data.participants
        && (
          (
            resource.data.sellerId == request.auth.uid
            && changedKeysOnly(['sellerUnread'])
            && request.resource.data.sellerUnread == 0
          )
          ||
          (
            resource.data.buyerId == request.auth.uid
            && changedKeysOnly(['buyerUnread'])
            && request.resource.data.buyerUnread == 0
          )
          ||
          (
            request.resource.data.lastMessage is string
            && request.resource.data.lastMessageType in ['text', 'offer']
            && request.resource.data.lastMessageSenderId == request.auth.uid
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.updatedAt == request.time
            && (
              request.resource.data.lastMessageType != 'offer'
              || (
                resource.data.contextType == 'direct'
                && request.resource.data.lastOfferAmount is number
                && request.resource.data.lastOfferAmount > 0
              )
            )
            && (
              (
                resource.data.sellerId == request.auth.uid
                && changedKeysOnly([
                  'lastMessage',
                  'lastMessageType',
                  'lastOfferAmount',
                  'lastMessageSenderId',
                  'lastMessageAt',
                  'buyerUnread',
                  'updatedAt'
                ])
                && request.resource.data.buyerUnread ==
                  (resource.data.keys().hasAny(['buyerUnread'])
                    ? resource.data.buyerUnread
                    : 0) + 1
              )
              ||
              (
                resource.data.buyerId == request.auth.uid
                && changedKeysOnly([
                  'lastMessage',
                  'lastMessageType',
                  'lastOfferAmount',
                  'lastMessageSenderId',
                  'lastMessageAt',
                  'sellerUnread',
                  'updatedAt'
                ])
                && request.resource.data.sellerUnread ==
                  (resource.data.keys().hasAny(['sellerUnread'])
                    ? resource.data.sellerUnread
                    : 0) + 1
              )
            )
          )
          ||
          (
            resource.data.contextType == 'direct'
            && resource.data.sellerId == request.auth.uid
            && !resource.data.keys().hasAny(['contactStatus'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage',
              'lastMessageType',
              'lastMessageSenderId',
              'lastMessageAt',
              'buyerUnread',
              'updatedAt',
              'contactStatus',
              'acceptedOfferId',
              'contactUnlockedAt'
            ])
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessageType == 'text'
            && request.resource.data.lastMessageSenderId == request.auth.uid
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.buyerUnread ==
              (resource.data.keys().hasAny(['buyerUnread'])
                ? resource.data.buyerUnread
                : 0) + 1
            && request.resource.data.contactStatus == 'unlocked'
            && request.resource.data.acceptedOfferId is string
            && request.resource.data.contactUnlockedAt == request.time
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.type == 'offer'
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.senderId == resource.data.buyerId
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.status == 'accepted'
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.decidedBy == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.decidedAt == request.time
          )
          ||
          (
            resource.data.contextType == 'direct'
            && resource.data.sellerId == request.auth.uid
            && (
              !resource.data.keys().hasAny(['contactStatus'])
              || resource.data.contactStatus != 'unlocked'
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'contactStatus',
              'acceptedOfferId',
              'contactUnlockedAt'
            ])
            && request.resource.data.contactStatus == 'unlocked'
            && request.resource.data.acceptedOfferId is string
            && request.resource.data.contactUnlockedAt == request.time
            && get(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.type == 'offer'
            && get(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.senderId == resource.data.buyerId
            && get(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.status == 'accepted'
            && get(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.acceptedOfferId)
            ).data.decidedBy == resource.data.sellerId
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if conversationIsParticipant(conversationId);

        allow create: if conversationIsParticipant(conversationId)
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.contextType == 'direct'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.keys().hasOnly([
                'type', 'text', 'senderId', 'createdAt'
              ])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1000
            )
            ||
            (
              request.resource.data.type == 'offer'
              && request.resource.data.keys().hasOnly([
                'type', 'offerAmount', 'text', 'status', 'senderId', 'createdAt'
              ])
              && request.resource.data.status == 'pending'
              && get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contextType == 'direct'
              && get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.buyerId == request.auth.uid
              && request.resource.data.offerAmount is number
              && request.resource.data.offerAmount > 0
              && (
                !request.resource.data.keys().hasAny(['text'])
                || (
                  request.resource.data.text is string
                  && request.resource.data.text.size() <= 1000
                )
              )
            )
          );

        allow update: if conversationIsParticipant(conversationId)
          && get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.contextType == 'direct'
          && get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.sellerId == request.auth.uid
          && resource.data.type == 'offer'
          && resource.data.senderId == get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.buyerId
          && (
            !resource.data.keys().hasAny(['status'])
            || resource.data.status == 'pending'
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'decidedBy', 'decidedAt'
          ])
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.decidedBy == request.auth.uid
          && request.resource.data.decidedAt == request.time
          && (
            request.resource.data.status != 'accepted'
            || (
              getAfter(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contactStatus == 'unlocked'
              && getAfter(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.acceptedOfferId == messageId
              && getAfter(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contactUnlockedAt == request.time
            )
          );

        allow delete: if false;
      }

      match /privateContacts/{contactUid} {
        allow get: if signedIn()
          && (
            contactUid == request.auth.uid
            || (
              conversationIsParticipant(conversationId)
              && contactUid in get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.participants
              && get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contextType == 'direct'
              && get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.contactStatus == 'unlocked'
            )
          );

        allow list: if false;

        allow create: if activeAccount()
          && contactUid == request.auth.uid
          && conversationIsParticipant(conversationId)
          && get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.contextType == 'direct'
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'phoneNumber', 'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName == get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.displayName
          && (
            !request.resource.data.keys().hasAny(['phoneNumber'])
            || (
              request.resource.data.phoneNumber is string
              && request.resource.data.phoneNumber == get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.phoneNumber
            )
          )
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /accountDeletionRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || hasPermission('users_view'));
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('users_view'));
      allow create: if activeAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasPermission('users_manage') && mayManageUser(uid)
        && resource.data.status in ['pending', 'in_review']
        && request.resource.data.status in ['in_review', 'completed']
        && changedKeysOnly(['status', 'updatedAt', 'processedBy', 'processedAt'])
        && request.resource.data.processedBy == request.auth.uid
        && request.resource.data.processedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if hasPermission('reports_view') || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly(['reporterId','targetType','targetId','reportedUserId','reason','details','status','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['user','animal','auction']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 128
        && reportId == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
        && request.resource.data.details is string && request.resource.data.details.size() <= 2000
        && ((request.resource.data.targetType == 'user'
          && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId))
          && request.resource.data.reportedUserId == request.resource.data.targetId)
          || (request.resource.data.targetType == 'animal'
          && get(/databases/$(database)/documents/animals/$(request.resource.data.targetId)).data.sellerId == request.resource.data.reportedUserId)
          || (request.resource.data.targetType == 'auction'
          && get(/databases/$(database)/documents/auctions/$(request.resource.data.targetId)).data.sellerId == request.resource.data.reportedUserId));
      allow update: if hasPermission('reports_manage') && changedKeysOnly(['status','reviewedAt','reviewedBy','resolutionNotes','moderationLogId'])
        && request.resource.data.status in ['reviewing','resolved','rejected']
        && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.resolutionNotes is string && request.resource.data.resolutionNotes.size() <= 500
        && validAudit('reports', reportId);
      allow delete: if false;
    }
    match /adminAuditLogs/{logId} {
      allow read: if hasPermission('admin_log_view');
      allow create: if canWriteAudit(request.resource.data)
        && request.resource.data.keys().hasOnly(['adminUid','action','targetType','targetId','reason','timestamp','metadata'])
        && request.resource.data.adminUid == request.auth.uid && request.resource.data.timestamp == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 100
        && request.resource.data.targetType in ['users','animals','auctions','purchaseRequests','reports','serviceRequests','accountDeletionRequests','adminAccess']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 300
        && request.resource.data.reason is string && request.resource.data.reason.trim().size() >= 3 && request.resource.data.reason.size() <= 500 && !request.resource.data.reason.matches('[\\s\\p{Z}]*')
        && request.resource.data.metadata is map && (
          (request.resource.data.targetType != 'adminAccess' && request.resource.data.metadata.keys().hasOnly(['imageHash'])
            && (!request.resource.data.metadata.keys().hasAny(['imageHash']) || request.resource.data.metadata.imageHash.matches('^[a-f0-9]{64}$')))
          || (request.resource.data.targetType == 'adminAccess'
            && request.resource.data.metadata.keys().hasOnly(['oldPermissions','newPermissions'])
            && validPermissions(request.resource.data.metadata.oldPermissions) && validPermissions(request.resource.data.metadata.newPermissions)
            && getAfter(/databases/$(database)/documents/adminAccess/$(request.resource.data.targetId)).data.moderationLogId == logId
            && getAfter(/databases/$(database)/documents/adminAccess/$(request.resource.data.targetId)).data.adminUpdatedAt == request.time)
        );
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }

// MELKAK marketplace transition
function mkActive(){return request.auth!=null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status=='active';}
  function mkRegistry(){return get(/databases/$(database)/documents/adminSecurity/config).data;}
  function mkOwner(){return mkActive() && request.auth.token.get('admin',false)==true && mkRegistry().enabled==true && request.auth.uid in mkRegistry().superAdminUids;}
  function mkPermit(p){return mkOwner() || (mkActive() && mkRegistry().enabled==true && mkRegistry().superAdminUids.size()>0 && get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.role=='admin_assistant' && get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.adminStatus=='active' && p in get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.permissions);}
  function mkCountryEnabled(country){return country in ['AE','SA','EG','OM','JO','MA'] && (!exists(/databases/$(database)/documents/marketplaceSettings/public) || country in get(/databases/$(database)/documents/marketplaceSettings/public).data.enabledCountries);}
  function mkCategoryEnabled(category){return exists(/databases/$(database)/documents/marketplaceCategories/$(category)) && get(/databases/$(database)/documents/marketplaceCategories/$(category)).data.enabled==true;}
  function mkCurrency(c){return c=='AE'?'AED':c=='SA'?'SAR':c=='EG'?'EGP':c=='OM'?'OMR':c=='JO'?'JOD':c=='MA'?'MAD':'';}
  function mkImage(v){return v is string && v.size()<=210000 && v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$');}
  function mkImages(d){return d.images is list && d.images.size()>=1 && d.images.size()<=3 && d.images.toSet().size()==d.images.size() && mkImage(d.images[0]) && (d.images.size()<2 || mkImage(d.images[1])) && (d.images.size()<3 || mkImage(d.images[2]));}
  function mkContact(d){let c=d.contact;return c is map && c.keys().hasOnly(['phone','consent','call','whatsapp','showNumber']) && c.consent==true && c.call is bool && c.whatsapp is bool && c.showNumber is bool && (c.call||c.whatsapp) && c.phone is string && c.phone.matches('^\\+[1-9][0-9]{7,14}$');}
  function mkAttr(d,k){return d.attributes.get(k,'') is string && d.attributes.get(k,'').size()<=300;}
  function mkFields(d){return d.attributes is map && (d.category=='livestock'?(d.attributes.keys().hasOnly(['type','breed','age','gender','color','health','identifier']) && mkAttr(d,'type') && mkAttr(d,'breed') && mkAttr(d,'age') && mkAttr(d,'gender') && mkAttr(d,'color') && mkAttr(d,'health') && mkAttr(d,'identifier')):d.category=='cars'?(d.attributes.keys().hasOnly(['brand','model','year','mileage','fuel','transmission','condition','color']) && mkAttr(d,'brand') && mkAttr(d,'model') && mkAttr(d,'year') && mkAttr(d,'mileage') && mkAttr(d,'fuel') && mkAttr(d,'transmission') && mkAttr(d,'condition') && mkAttr(d,'color')):d.category=='phones'?(d.attributes.keys().hasOnly(['brand','model','capacity','condition','color']) && mkAttr(d,'brand') && mkAttr(d,'model') && mkAttr(d,'capacity') && mkAttr(d,'condition') && mkAttr(d,'color')):d.category=='computers'?(d.attributes.keys().hasOnly(['type','brand','model','specs','condition']) && mkAttr(d,'type') && mkAttr(d,'brand') && mkAttr(d,'model') && mkAttr(d,'specs') && mkAttr(d,'condition')):d.category=='appliances'?(d.attributes.keys().hasOnly(['type','brand','condition','age']) && mkAttr(d,'type') && mkAttr(d,'brand') && mkAttr(d,'condition') && mkAttr(d,'age')):d.category=='furniture'?(d.attributes.keys().hasOnly(['type','condition','material','color']) && mkAttr(d,'type') && mkAttr(d,'condition') && mkAttr(d,'material') && mkAttr(d,'color')):d.category=='children'?(d.attributes.keys().hasOnly(['type','suitableAge','condition']) && mkAttr(d,'type') && mkAttr(d,'suitableAge') && mkAttr(d,'condition')):d.category=='tools'?(d.attributes.keys().hasOnly(['type','brand','condition']) && mkAttr(d,'type') && mkAttr(d,'brand') && mkAttr(d,'condition')):(d.attributes.keys().hasOnly(['type','condition']) && mkAttr(d,'type') && mkAttr(d,'condition')));}
  function mkValid(d){return d.keys().hasOnly(['schemaVersion','ownerUid','category','country','region','city','currency','title','description','price','images','attributes','contact','status','createdAt','updatedAt','hiddenBy','moderationLocked','moderationStatus','requiresReview','hasHistory','historyRequestId','auditId','featured','featuredStatus','featuredDurationDays','featuredStartAt','featuredEndAt','featuredRequestId','bumpedAt','bumpRequestId','featuredPriority','removed']) && d.schemaVersion==1 && d.ownerUid is string && d.category in ['livestock','cars','phones','computers','appliances','furniture','tools','sports','children','other'] && d.country in ['AE','SA','EG','OM','JO','MA'] && d.currency==mkCurrency(d.country) && d.region is string && d.region.size()>0 && d.region.size()<=100 && d.city is string && d.city.size()>0 && d.city.size()<=100 && d.title is string && d.title.size()>=3 && d.title.size()<=100 && d.description is string && d.description.size()>=10 && d.description.size()<=2000 && d.price is number && d.price>=0 && d.price<=10000000000 && mkImages(d) && mkContact(d) && mkFields(d);}
  function mkEditable(d){return d.get('removed',false)==false && d.get('moderationLocked',false)==false && d.get('requiresReview',false)==false && !(d.get('moderationStatus','') in ['rejected','suspended','needs_review','pending']) && d.get('hiddenBy','')!='admin';}
  function mkOwnerTransition(before,after){return (before.status=='active' && ((after.status in ['active','sold'] && (after.status!='active' || after.country==before.country || mkCountryEnabled(after.country)) && after.get('hiddenBy','')==before.get('hiddenBy','')) || (after.status=='hidden' && after.hiddenBy=='owner'))) || (before.status=='hidden' && before.get('hiddenBy','')=='owner' && ((after.status=='hidden' && after.hiddenBy=='owner') || (after.status=='active' && after.hiddenBy=='' && mkCountryEnabled(after.country) && mkCategoryEnabled(before.category))));}
  function mkAudit(d,collection,id,action,result){let a=getAfter(/databases/$(database)/documents/marketplaceAuditLogs/$(d.auditId)).data;return (resource==null || d.auditId!=resource.data.get('auditId','')) && a.actorUid==request.auth.uid && a.targetCollection==collection && a.targetId==id && a.action==action && a.result==result && a.timestamp==request.time;}
  function mkLinkedHistory(d,id){let r=getAfter(/databases/$(database)/documents/marketplaceRequests/$(d.historyRequestId)).data;return d.diff(resource.data).affectedKeys().hasOnly(['hasHistory','historyRequestId','updatedAt']) && mkActive() && resource.data.status=='active' && d.hasHistory==true && d.historyRequestId!=resource.data.get('historyRequestId','') && r.ownerUid==request.auth.uid && r.listingId==id && r.type in ['featured','bump','report'] && r.createdAt==request.time && d.diff(resource.data).affectedKeys().hasOnly(['hasHistory','historyRequestId','updatedAt']);}
  function mkFeaturedApproval(d,id){let r=getAfter(/databases/$(database)/documents/marketplaceRequests/$(d.featuredRequestId)).data;return r.type=='featured' && r.listingId==id && r.status=='approved' && r.updatedAt==request.time && mkOwner() && resource.data.status=='active' && mkEditable(resource.data) && d.diff(resource.data).affectedKeys().hasOnly(['featured','featuredStatus','featuredDurationDays','featuredStartAt','featuredEndAt','featuredRequestId','hasHistory','auditId','updatedAt']) && d.hasHistory==true && d.featured==true && d.featuredStatus=='approved' && d.featuredDurationDays is int && d.featuredDurationDays>=1 && d.featuredDurationDays<=365 && d.featuredStartAt is number && d.featuredEndAt-d.featuredStartAt==d.featuredDurationDays*86400000 && mkAudit(d,'marketplaceListings',id,'featured-approved','approved');}
  function mkBumpApproval(d,id){let r=getAfter(/databases/$(database)/documents/marketplaceRequests/$(d.bumpRequestId)).data;return mkOwner() && resource.data.status=='active' && mkEditable(resource.data) && r.type=='bump' && r.listingId==id && r.status=='approved' && r.updatedAt==request.time && d.bumpedAt==request.time && d.hasHistory==true && d.diff(resource.data).affectedKeys().hasOnly(['bumpedAt','bumpRequestId','hasHistory','auditId','updatedAt']) && mkAudit(d,'marketplaceListings',id,'bump-approved','approved');}
  function mkPriorityUpdate(d,id){return mkOwner() && resource.data.status=='active' && resource.data.featured==true && resource.data.featuredStatus=='approved' && resource.data.featuredEndAt>request.time.toMillis() && d.featuredPriority is int && d.featuredPriority>=0 && d.featuredPriority<=100 && d.diff(resource.data).affectedKeys().hasOnly(['featuredPriority','auditId','updatedAt']) && mkAudit(d,'marketplaceListings',id,'featured-priority','updated');}
  function mkDeletionProof(id){let d=getAfter(/databases/$(database)/documents/marketplaceDeletions/$(id)).data;let a=getAfter(/databases/$(database)/documents/marketplaceAuditLogs/$(d.auditId)).data;return mkOwner() && resource.data.get('hasHistory',true)==false && d.listingId==id && d.ownerUid==resource.data.ownerUid && d.actorUid==request.auth.uid && d.timestamp==request.time && a.action=='listing-deleted' && a.targetCollection=='marketplaceListings' && a.targetId==id && a.result=='deleted' && a.actorUid==request.auth.uid && a.reason==d.reason && a.timestamp==request.time;}
  function mkModeration(d,id){return mkPermit('listings_manage') && resource.data.get('removed',false)==false && (d.status!='active' || (mkCountryEnabled(d.country) && mkImages(d) && d.get('requiresReview',false)==false && !(d.get('moderationStatus','') in ['rejected','suspended','needs_review','pending']))) && d.status in ['active','hidden','needs_review','rejected','archived'] && d.hasHistory==true && d.moderationLocked==(d.status!='active') && d.hiddenBy==(d.status=='hidden'?'admin':'') && d.diff(resource.data).affectedKeys().hasOnly(['status','hiddenBy','moderationLocked','hasHistory','auditId','updatedAt']) && mkAudit(d,'marketplaceListings',id,'moderate-'+d.status,d.status);}
  // Empty images are only allowed on locked review records; publishing still requires 1-3 images.
  function mkImageRemoval(d,id){return d.diff(resource.data).affectedKeys().hasAny(['images']) && mkPermit('listings_manage') && resource.data.get('removed',false)==false && d.images is list && resource.data.images is list && d.images.size()==resource.data.images.size()-1 && d.images.size()>=0 && d.images.size()<=2 && d.images==resource.data.images.removeAll(resource.data.images.removeAll(d.images)) && d.images.toSet().difference(resource.data.images.toSet()).size()==0 && d.status=='needs_review' && d.hiddenBy=='' && d.moderationLocked==true && d.hasHistory==true && d.diff(resource.data).affectedKeys().hasOnly(['images','status','hiddenBy','moderationLocked','hasHistory','auditId','updatedAt']) && mkAudit(d,'marketplaceListings',id,'listing-image-removed','needs_review');}
  function mkPermanentRemoval(d,id){return d.get('removed',false)==true && mkOwner() && resource.data.get('hasHistory',true)!=false && resource.data.get('removed',false)==false && d.removed==true && d.status=='archived' && d.hiddenBy=='' && d.moderationLocked==true && d.hasHistory==true && d.diff(resource.data).affectedKeys().hasOnly(['removed','status','hiddenBy','moderationLocked','hasHistory','auditId','updatedAt']) && mkAudit(d,'marketplaceListings',id,'listing-removed','archived');}
  match /marketplaceListings/{id} {
   allow read: if resource.data.status=='active' || (mkActive() && resource.data.ownerUid==request.auth.uid) || mkPermit('listings_view') || mkPermit('listings_manage');
   allow create: if mkActive() && mkCountryEnabled(request.resource.data.country) && mkCategoryEnabled(request.resource.data.category) && request.resource.data.ownerUid==request.auth.uid && mkValid(request.resource.data) && !request.resource.data.keys().hasAny(['moderationLocked','moderationStatus','requiresReview','historyRequestId','auditId','featured','featuredStatus','featuredStartAt','featuredEndAt','featuredDurationDays','featuredRequestId','bumpedAt','bumpRequestId','featuredPriority','removed']) && request.resource.data.hasHistory==false && request.resource.data.get('hiddenBy','')=='' && request.resource.data.status=='active' && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   allow update: if mkActive() && request.resource.data.ownerUid==resource.data.ownerUid && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.category==resource.data.category && request.resource.data.updatedAt==request.time && ((resource.data.ownerUid==request.auth.uid && mkEditable(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','price','images','attributes','contact','country','region','city','currency','status','hiddenBy','updatedAt']) && mkValid(request.resource.data) && mkOwnerTransition(resource.data,request.resource.data)) || mkImageRemoval(request.resource.data,id) || mkPermanentRemoval(request.resource.data,id) || mkLinkedHistory(request.resource.data,id) || mkPriorityUpdate(request.resource.data,id) || mkBumpApproval(request.resource.data,id) || mkFeaturedApproval(request.resource.data,id) || mkModeration(request.resource.data,id));
   allow delete: if mkActive() && ((resource.data.ownerUid==request.auth.uid && resource.data.get('hasHistory',true)==false && mkEditable(resource.data) && resource.data.status in ['active','hidden']) || mkDeletionProof(id));
  }
  match /marketplaceDeletions/{id}{allow read: if mkOwner();allow create: if mkOwner() && request.resource.data.keys().hasOnly(['listingId','ownerUid','actorUid','reason','auditId','timestamp']) && request.resource.data.listingId==id && request.resource.data.actorUid==request.auth.uid && request.resource.data.timestamp==request.time && mkBoundedReason(request.resource.data) && exists(/databases/$(database)/documents/marketplaceListings/$(id)) && !existsAfter(/databases/$(database)/documents/marketplaceListings/$(id)) && get(/databases/$(database)/documents/marketplaceListings/$(id)).data.get('hasHistory',true)==false && request.resource.data.ownerUid==get(/databases/$(database)/documents/marketplaceListings/$(id)).data.ownerUid && getAfter(/databases/$(database)/documents/marketplaceAuditLogs/$(request.resource.data.auditId)).data.targetId==id && getAfter(/databases/$(database)/documents/marketplaceAuditLogs/$(request.resource.data.auditId)).data.action=='listing-deleted';allow update,delete: if false;}
  function mkBoundedReason(d){return d.reason is string && d.reason.trim().size()>=3 && d.reason.size()<=500 && !d.reason.matches('[\\s\\p{Z}]*');}
  function mkRequestParent(d,id){let p=getAfter(/databases/$(database)/documents/marketplaceListings/$(d.listingId)).data;return p.hasHistory==true && p.historyRequestId==id && p.status=='active' && (d.type=='report'||(p.ownerUid==request.auth.uid && mkEditable(p)));}
  function mkCommercial(d){let c=d.data;return c is map && c.keys().hasOnly(['title','advertiserName','description','cta','image','targetUrl','countryTarget','placement','startAt','endAt','priority']) && c.title is string && c.title.size()>0 && c.title.size()<=100 && c.advertiserName is string && c.advertiserName.size()>0 && c.advertiserName.size()<=100 && c.description is string && c.description.size()<=500 && c.cta is string && c.cta.size()>0 && c.cta.size()<=50 && mkImage(c.image) && c.image.size()<=110000 && c.targetUrl is string && c.targetUrl.size()<=2000 && (c.targetUrl=='' || c.targetUrl.matches('^https://[^/@ \\t\\r\\n]+[./][^@ \\t\\r\\n]*$')) && c.countryTarget in ['ALL','AE','SA','EG','OM','JO','MA'] && c.placement in ['hero','hero_side_1','hero_side_2','hero_side_3','middle','footer_1','footer_2','footer_3','footer_4','footer_5'] && c.startAt is number && c.endAt is number && c.endAt>c.startAt && c.endAt-c.startAt<=31536000000 && c.priority is int && c.priority>=1 && c.priority<=10;}
  function mkRequestCreate(d,id){return d.ownerUid==request.auth.uid && d.createdAt==request.time && ((d.type=='bump' && d.keys().hasOnly(['type','ownerUid','listingId','status','reason','createdAt']) && d.status=='pending' && d.reason=='' && mkRequestParent(d,id)) || (d.type=='featured' && d.keys().hasOnly(['type','ownerUid','listingId','status','reason','featuredDurationDays','featuredStartAt','featuredEndAt','createdAt']) && d.status=='pending' && d.reason=='' && d.featuredDurationDays is int && d.featuredDurationDays>=1 && d.featuredDurationDays<=365 && d.featuredStartAt is number && d.featuredEndAt-d.featuredStartAt==d.featuredDurationDays*86400000 && mkRequestParent(d,id)) || (d.type=='report' && d.keys().hasOnly(['type','ownerUid','listingId','targetType','targetUid','reason','status','createdAt']) && d.status=='open' && mkBoundedReason(d) && (('listingId' in d && !d.keys().hasAny(['targetUid','targetType']) && mkRequestParent(d,id)) || (!('listingId' in d) && d.targetType=='user' && d.targetUid is string && exists(/databases/$(database)/documents/users/$(d.targetUid))))) || (d.type=='commercial' && d.keys().hasOnly(['type','ownerUid','status','createdAt','data']) && d.status=='pending' && mkCommercial(d)));}
  function mkActivated(d,id){let p=getAfter(/databases/$(database)/documents/marketplaceListings/$(d.listingId)).data;return d.type=='bump'?(p.bumpRequestId==id && p.bumpedAt==request.time && p.updatedAt==request.time):p.featured==true && p.featuredStatus=='approved' && p.featuredRequestId==id && p.updatedAt==request.time && p.featuredEndAt>p.featuredStartAt;}
  function mkDecision(d,id){return d.diff(resource.data).affectedKeys().hasOnly(['status','auditId','updatedAt']) && d.updatedAt==request.time && ((resource.data.type in ['featured','bump'] && mkOwner() && resource.data.status=='pending' && d.status in ['approved','rejected'] && (d.status=='rejected'||mkActivated(d,id)) && mkAudit(d,'marketplaceRequests',id,'service-'+d.status,d.status)) || (resource.data.type=='commercial' && mkOwner() && ((resource.data.status=='pending' && d.status in ['approved','rejected']) || (resource.data.status=='approved' && d.status in ['paused','rejected']) || (resource.data.status=='paused' && d.status=='approved')) && (d.status!='approved'||d.data.endAt>request.time.toMillis()) && mkAudit(d,'marketplaceRequests',id,'commercial-'+d.status,d.status)) || (resource.data.type=='report' && mkPermit('reports_manage') && resource.data.status in ['open','reviewing','escalated'] && d.status in ['reviewing','dismissed','escalated','resolved'] && mkAudit(d,'marketplaceRequests',id,'report-'+d.status,d.status)));}

  function mkCurrentCampaign(d){return d.status=='approved' && d.startAt<=request.time.toMillis() && d.endAt>request.time.toMillis();}
  function mkPublishedCampaign(d,id){let r=getAfter(/databases/$(database)/documents/marketplaceRequests/$(id)).data;return mkOwner() && r.type=='commercial' && r.status==d.status && r.auditId==d.auditId && r.updatedAt==request.time && d.updatedAt==request.time && d.requestId==id && d.ownerUid==r.ownerUid && d.keys().hasOnly(['title','advertiserName','description','cta','targetUrl','placement','countryTarget','startAt','endAt','priority','status','ownerUid','requestId','updatedAt','auditId']) && d.title==r.data.title && d.advertiserName==r.data.advertiserName && d.description==r.data.description && d.cta==r.data.cta && d.targetUrl==r.data.targetUrl && d.placement==r.data.placement && d.countryTarget==r.data.countryTarget && d.startAt==r.data.startAt && d.endAt==r.data.endAt && d.priority==r.data.priority && mkCommercial(r) && r.data.image.size()<=110000;}
  function mkCampaignPublicationLinked(d,id){let p=getAfter(/databases/$(database)/documents/marketplaceCommercialAds/$(id)).data;let i=getAfter(/databases/$(database)/documents/marketplaceCommercialImages/$(id)).data;return p.status==d.status && p.auditId==d.auditId && p.updatedAt==request.time && i.updatedAt==request.time && i.imageData==d.data.image;}
  function mkCommercialDecision(d,id){return mkOwner() && resource.data.type=='commercial' && d.type=='commercial' && d.ownerUid==resource.data.ownerUid && d.createdAt==resource.data.createdAt && d.updatedAt==request.time && mkCommercial(d) && d.data.image.size()<=110000 && (d.status!='approved'||d.data.endAt>request.time.toMillis()) && ((d.diff(resource.data).affectedKeys().hasOnly(['status','auditId','updatedAt']) && ((resource.data.status=='pending' && d.status in ['approved','rejected']) || (resource.data.status=='approved' && d.status in ['paused','rejected']) || (resource.data.status=='paused' && d.status in ['approved','rejected'])) && mkAudit(d,'marketplaceRequests',id,'commercial-'+d.status,d.status)) || (d.diff(resource.data).affectedKeys().hasOnly(['data','auditId','updatedAt']) && mkAudit(d,'marketplaceRequests',id,'commercial-edited','edited'))) && ((d.status!='approved' && !exists(/databases/$(database)/documents/marketplaceCommercialAds/$(id))) || mkCampaignPublicationLinked(d,id));}
  match /marketplaceCommercialAds/{id}{
   allow read: if mkCurrentCampaign(resource.data) || mkOwner();
   allow create,update: if mkPublishedCampaign(request.resource.data,id);
   allow delete: if false;
  }
  match /marketplaceCommercialImages/{id}{
   allow get: if mkCurrentCampaign(get(/databases/$(database)/documents/marketplaceCommercialAds/$(id)).data) || mkOwner();
   allow list,delete: if false;
   allow create,update: if mkOwner() && request.resource.data.keys().hasOnly(['imageData','updatedAt']) && request.resource.data.updatedAt==request.time && mkImage(request.resource.data.imageData) && request.resource.data.imageData.size()<=110000 && getAfter(/databases/$(database)/documents/marketplaceRequests/$(id)).data.data.image==request.resource.data.imageData && getAfter(/databases/$(database)/documents/marketplaceRequests/$(id)).data.updatedAt==request.time && getAfter(/databases/$(database)/documents/marketplaceCommercialAds/$(id)).data.updatedAt==request.time;
  }

  match /marketplaceRequests/{id}{
   allow read: if mkActive() && (resource.data.ownerUid==request.auth.uid || (resource.data.type=='report' && (mkPermit('reports_view')||mkPermit('reports_manage'))) || (resource.data.type in ['featured','bump','commercial'] && (mkPermit('services_view')||mkOwner())));
   allow create: if mkActive() && mkRequestCreate(request.resource.data,id);
   allow update: if mkActive() && (resource.data.type=='commercial'?mkCommercialDecision(request.resource.data,id):mkDecision(request.resource.data,id));
   allow delete: if false;
  }
  match /marketplaceAuditLogs/{id}{
   allow read: if mkPermit('admin_log_view');
   allow create: if mkActive() && request.resource.data.keys().hasOnly(['actorUid','action','targetId','targetCollection','reason','timestamp','result']) && request.resource.data.actorUid==request.auth.uid && mkBoundedReason(request.resource.data) && request.resource.data.timestamp==request.time && request.resource.data.action is string && request.resource.data.result is string && ((request.resource.data.targetCollection=='marketplaceListings' && mkPermit('listings_manage') && ((existsAfter(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.targetId)) && getAfter(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.targetId)).data.auditId==id) || (mkOwner() && existsAfter(/databases/$(database)/documents/marketplaceDeletions/$(request.resource.data.targetId)) && getAfter(/databases/$(database)/documents/marketplaceDeletions/$(request.resource.data.targetId)).data.auditId==id && getAfter(/databases/$(database)/documents/marketplaceDeletions/$(request.resource.data.targetId)).data.timestamp==request.time))) || (request.resource.data.targetCollection=='marketplaceRequests' && (mkOwner()||mkPermit('reports_manage')) && getAfter(/databases/$(database)/documents/marketplaceRequests/$(request.resource.data.targetId)).data.auditId==id) || (request.resource.data.targetCollection in ['marketplaceCategories','marketplaceSettings','marketplaceCities'] && mkOwner() && getAfter(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId)).data.auditId==id));
   allow update,delete: if false;
  }
  match /marketplaceCategories/{id}{
   allow read: if true;
   allow create,update: if id in ['livestock','cars','phones','computers','appliances','furniture','tools','sports','children','other'] && mkOwner() && request.resource.data.keys().hasOnly(['enabled','order','featured','icon','updatedAt','auditId']) && request.resource.data.enabled is bool && request.resource.data.featured is bool && request.resource.data.order is int && request.resource.data.order>=0 && request.resource.data.order<=99 && request.resource.data.icon in ['car','phone','computer','appliance','sofa','tool','bike','baby','grid','camel'] && request.resource.data.updatedAt==request.time && mkAudit(request.resource.data,'marketplaceCategories',id,'category-update','updated');
   allow delete: if false;
  }
  function mkSettingData(d){return d.keys().hasOnly(['enabledCountries','supportText','updatedAt','auditId']) && d.enabledCountries is list && d.enabledCountries.size()>=1 && d.enabledCountries.size()<=6 && d.enabledCountries.toSet().size()==d.enabledCountries.size() && d.enabledCountries.hasOnly(['AE','SA','EG','OM','JO','MA']) && d.supportText is string && d.supportText.size()<=500;}
  function mkCityData(d){return d.keys().hasOnly(['country','region','name','enabled','updatedAt','auditId']) && d.country in ['AE','SA','EG','OM','JO','MA'] && d.region is string && d.region.trim().size()>0 && d.region.size()<=100 && d.name is string && d.name.trim().size()>0 && d.name.size()<=100 && d.enabled is bool;}
  match /marketplaceSettings/{id}{allow read: if id=='public';allow create,update: if id=='public' && mkOwner() && mkSettingData(request.resource.data) && request.resource.data.updatedAt==request.time && mkAudit(request.resource.data,'marketplaceSettings',id,'settings-update','updated');allow delete: if false;}
  match /marketplaceCities/{id}{allow read: if true;allow create,update: if mkOwner() && mkCityData(request.resource.data) && request.resource.data.updatedAt==request.time && mkAudit(request.resource.data,'marketplaceCities',id,'city-update','updated');allow delete: if false;}
  // Read support for the real auth adapter; role/registry writes stay unavailable in this proposal.
// End MELKAK marketplace transition
  }
}
